+
+test('legacy translation controls and feedback belong only to Live view; the published record stays verbatim', async t => {
+  const record = JSON.parse(readFileSync(new URL('./fixtures/sim/simulation_record.en.json', import.meta.url), 'utf8'))
+  record.periods[0].narrative = 'Published record prose stays verbatim.'
+  let failed = true
+  const h = mount(t, buildLegacy, { api: {
+    ...legacyApi(),
+    fetchRecord: async () => ({ record, status: 200, publicationStatus: 'passed' }),
+  }, start: async (id, lang, force, options) => {
+    if (force) failed = false
+    return response(id, lang, options, failed
+      ? { status: 'failed', issues: ['translation integrity failed'], translations: [], pending: options.texts.length }
+      : { translations: options.texts.map(source => ({ source, text: LEGACY_TEXT[source] || source, source_sha256: sha(source) })) })
+  } })
+  await settle()
+  assert.equal(h.state.showRecord.value, true)
+  let html = await h.render()
+  assert.match(html, /class="sim-record"/)
+  assert.match(prose(html), /Published record prose stays verbatim\./)
+  assert.doesNotMatch(prose(html), /翻译整个模拟|原文 \/ English|重试翻译|Retry translation/)
+  assert.equal(h.calls.length, 0)
+
+  h.state.showRecord.value = false
+  html = await h.render()
+  assert.match(prose(html), /中文 · 翻译整个模拟/)
+  h.state.translation.toggle(); await settle()
+  html = await h.render()
+  assert.match(prose(html), /重试翻译/)
+  assert.match(prose(html), /The tariff stays at 12%/)
+  assert.ok(h.calls.every(call => !call.options.texts?.includes(record.periods[0].narrative)))
+
+  h.state.showRecord.value = true
+  html = await h.render()
+  assert.match(prose(html), /Published record prose stays verbatim\./)
+  assert.doesNotMatch(html, /class="sv-translation"/)
+  assert.doesNotMatch(prose(html), /翻译整个模拟|原文 \/ English|重试翻译|Retry translation/)
+
+  h.state.showRecord.value = false
+  assert.match(prose(await h.render()), /重试翻译/)
+  await h.state.translation.retry()
+  assert.equal(h.calls.at(-1).force, true)
+  assert.match(prose(await h.render()), /关税维持在 12%。/)
+  assert.match(prose(await h.render()), /原文 \/ English/)
+  assert.equal(i18n.locale.value, 'en', 'the existing local language switch remains independent')
+})
