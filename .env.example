# ===== LLM 提供方 =====
# claude-cli: 通过本机 `claude` CLI 调用（使用 Claude Code 订阅，无需 API Key）【默认】
# codex-cli:  通过本机 `codex` CLI 调用（使用 Codex 订阅，无需 API Key）
# openai:     回退到 OpenAI 兼容 API（需要下方 LLM_API_KEY）
# kimi:       Kimi-for-coding（api.kimi.com/coding，OpenAI 兼容 + coding-agent UA 网关）
# minimax:    MiniMax-M3（api.minimaxi.com，OpenAI 兼容，推理模型，512K 输出上限）
# deepseek:   DeepSeek（api.deepseek.com，OpenAI 兼容；默认 deepseek-chat，研究阶段用旗舰 deepseek-v4-pro）
# qwen:       通义千问（百炼国际站，OpenAI 兼容；默认 qwen-plus，研究阶段用旗舰 qwen3.7-max）
# glm:        智谱 GLM-4.6（api.z.ai，OpenAI 兼容）
LLM_PROVIDER=claude-cli

# ===== OpenAI 兼容 API 配置（仅 LLM_PROVIDER=openai 时需要）=====
# 支持 OpenAI SDK 格式的任意 LLM API
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_NAME=qwen-plus

# ===== Kimi-for-coding 配置（仅 LLM_PROVIDER=kimi 时需要）=====
# 模型为 kimi-for-coding（Kimi-k2.6，推理模型）。BASE_URL/MODEL_NAME 留空会自动用下方默认值。
# 关键：kimi-for-coding 仅对“coding agent”客户端开放，必须发送被识别的 User-Agent，
# 否则返回 access_terminated_error；LLM_USER_AGENT 默认 claude-cli/1.0.0。
# LLM_API_KEY=sk-kimi-xxxxxxxx
# LLM_BASE_URL=https://api.kimi.com/coding/v1
# LLM_MODEL_NAME=kimi-for-coding
# LLM_USER_AGENT=claude-cli/1.0.0
# 若也让 DeerFlow 深度研究走 Kimi：设 KIMI_API_KEY=<同一把 Key> 且 DEERFLOW_MODEL=kimi
# KIMI_API_KEY=sk-kimi-xxxxxxxx

# ===== MiniMax 代码计划配置（仅 LLM_PROVIDER=minimax 时需要）=====
# 国内版 OpenAI 兼容端点；BASE_URL/MODEL_NAME 留空会自动用下方默认值。
# MiniMax-M3 是推理模型（会把 <think> 内联进 content）；默认关闭推理(thinking:disabled)
# 以获得稳定可解析的 JSON 输出，可设 LLM_MINIMAX_DISABLE_THINKING=false 重新开启。
# 注意：MiniMax 不做 User-Agent 校验（无需 LLM_USER_AGENT）。
# LLM_API_KEY=sk-cp-xxxxxxxx          # MiniMax 代码计划订阅 Key（sk-cp- 前缀）
# LLM_BASE_URL=https://api.minimaxi.com/v1
# LLM_MODEL_NAME=MiniMax-M3
# LLM_MINIMAX_DISABLE_THINKING=true
# 若也让 DeerFlow 深度研究走 MiniMax：设 MINIMAX_API_KEY=<同一把 Key> 且 DEERFLOW_MODEL=minimax
# MINIMAX_API_KEY=sk-cp-xxxxxxxx

# ===== DeepSeek 配置（仅 LLM_PROVIDER=deepseek 时需要）=====
# 报告/模拟阶段默认用经济的 deepseek-chat（高频调用更划算）；深度研究阶段由
# deer-flow/config.yaml 改用旗舰 deepseek-v4-pro（百万级上下文）。
# BASE_URL/MODEL_NAME 留空会自动用下方默认值。
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat
# 若也让 DeerFlow 深度研究走 DeepSeek：设 DEEPSEEK_API_KEY=<同一把 Key> 且 DEERFLOW_MODEL=deepseek
# DEEPSEEK_API_KEY=sk-xxxxxxxx

# ===== 通义千问 Qwen 配置（仅 LLM_PROVIDER=qwen 时需要）=====
# 报告/模拟阶段默认用 qwen-plus；深度研究阶段由 deer-flow/config.yaml 改用旗舰
# qwen3.7-max（百万级上下文）。BASE_URL/MODEL_NAME 留空会自动用下方默认值。
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_NAME=qwen-plus
# 若也让 DeerFlow 深度研究走 Qwen：设 DASHSCOPE_API_KEY=<同一把 Key> 且 DEERFLOW_MODEL=qwen
# DASHSCOPE_API_KEY=sk-xxxxxxxx

# ===== 智谱 GLM 配置（仅 LLM_PROVIDER=glm 时需要）=====
# GLM-4.6。BASE_URL/MODEL_NAME 留空会自动用下方默认值。
# LLM_API_KEY=xxxxxxxx
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_MODEL_NAME=glm-4.6
# 若也让 DeerFlow 深度研究走 GLM：设 ZHIPUAI_API_KEY=<同一把 Key> 且 DEERFLOW_MODEL=glm
# ZHIPUAI_API_KEY=xxxxxxxx

# ===== 本地知识图谱（Graphiti，零配置、无需 API Key）=====
# 知识图谱在本机运行：默认嵌入式 FalkorDB（falkordblite，无需 Docker / 账号 / Key）。
# 实体/关系抽取复用上面的 LLM_PROVIDER；向量嵌入用本地多语言模型（首跑自动下载一次）。
# 图数据库后端：auto（推荐）| falkordblite | kuzu | falkordb
# GRAPH_BACKEND=auto
# 图数据落盘目录（默认 backend/uploads/graphiti_db）
# GRAPHITI_DATA_DIR=
# 本地嵌入模型与维度（更换模型时两者要匹配）
# GRAPHITI_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# GRAPHITI_EMBED_DIM=384
# 重排序：rrf（默认，纯本地零下载）| bge（本地交叉编码器，更准但需下载模型）
# GRAPHITI_RERANKER=rrf
# 可选：连接外部 FalkorDB 服务（设置后 GRAPH_BACKEND=auto 会优先使用）
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# 瞬态错误重试旋钮（沿用旧名，作用于本地图谱读取；仅特殊调优时打开）
# ZEP_MAX_RETRIES=2                    # 瞬态错误重试预算（GRAPH-9/GRAPH-11，4→2）；防一个卡死 op 在失败前耗掉 4×op_timeout
# ZEP_RETRY_DELAY_SECONDS=2.0
# ZEP_RATE_LIMIT_BUFFER_SECONDS=1.0
# ZEP_RATE_LIMIT_MAX_SLEEP_SECONDS=90.0

# ===== 文本切块（图谱 episode 粒度）=====
# DEFAULT_CHUNK_SIZE=2500              # chars per graph episode (was 500). ~5x fewer episodes + higher relationship recall; the single biggest graph-stage speedup. orchestrator reads Config default directly.（CHUNK-1/GRAPH-2/ONTO-1/ONTO-2/RESEARCH-1）
# DEFAULT_CHUNK_OVERLAP=250            # ~10% of chunk size (was 50); proportional to the larger chunk.（CHUNK-1/GAP-3）

# ===== Flask（可选）=====
# debug 模式仅供开发：会在 0.0.0.0 暴露 Werkzeug 调试器，且 reloader 重启会
# 杀死在飞的研究/模拟管线。默认关闭。
# FLASK_DEBUG=false
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5001

# ===== 加速 LLM 配置（可选，仅 LLM_PROVIDER=openai 时生效）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== OASIS 并发上限（可选）=====
# CLI 提供方默认 8（防止本机 CLI 过载），openai 兼容提供方默认 24
# OASIS_CLI_SEMAPHORE=8
# OASIS_SEMAPHORE=24                   # in-flight agent LLM calls (split //platforms); ramp 16->24->32 watching p95.（SIM-3）

# ===== DeerFlow 深度研究集成（可选，"一句话 → 研究 → 预测"；全部有默认值）=====
# Step 0 会调用仓库内 deer-flow/ 的 deerflow_research.py（运行在它自己的 venv 里），
# 用 Claude Code 订阅联网调研生成种子材料，再喂给 MiroFish 预测管线。详见 DEERFLOW_INTEGRATION.md。
# 不配置也能用：DEERFLOW_DIR 默认指向仓库内的 deer-flow/（./setup.sh 自动下载），venv 自动探测。
# DEERFLOW_DIR=                       # 留空 = <repo>/deer-flow
# DEERFLOW_PYTHON=                    # 留空 = 自动探测 deer-flow/backend/.venv/bin/python，再退回 `uv run`
# DEERFLOW_MODEL=claude               # 研究模型：claude | minimax | deepseek | qwen | glm | codex | kimi | antigravity
#   ⚠️ 研究质量对模型能力高度敏感：弱/低推理档模型（如 gemini-3.5-flash-low）在多轮深度研究中
#   更易「查询固着」（对同一冷门事实反复换皮搜索）且不严格遵循 source-grounding 纪律。
#   追求高质量/高覆盖时，深度研究建议用更强的模型（claude-sonnet/opus、gpt-5.x、deepseek-v4-pro 等）。
#   skill + 覆盖门对所有模型都有帮助，但更强的模型把它们的收益放大。
#                                     # （默认 claude = Claude Code OAuth，无需 API Key）
# DEERFLOW_RESEARCH_DEPTH=deep        # quick | standard | deep（deep 会运行多轮调研协议；CONF-1 默认 deep）
# DEERFLOW_RESEARCH_LANGUAGE=         # 研究报告/结构化输出语言；默认留空 = 按 brief 自动检测（英文 brief→英文报告）；显式设 Chinese/English 强制该语言
# DEERFLOW_RESEARCH_TIMEOUT=          # 留空 = 随深度自适应：quick 900s / standard 7200s / deep 21600s（双轨/子代理/扇出任一开启时档位值 ×1.5，见 Config.deerflow_depth_budget）
# DEERFLOW_SUBAGENTS=true             # 是否启用 DeerFlow 子代理（并行 scoped workers，更深；CONF-1 默认开）
# DEER_FLOW_MAX_CONCURRENT_SUBAGENTS=5  # 同时在飞的并行子代理上限（harness 侧旋钮）。覆盖 deerflow_bridge/config.yaml 的 subagents.max_concurrent（默认 5，本轮从旧硬编码 3 抬起）。取值 clamp 到 [1,8]（越界降级到边界、非法值忽略回退 config）。封顶单条 model 回复里保留的并行 `task` 调用数（SubagentLimitMiddleware），调度线程池按 clamp 上限 8 固定开池提供余量。仅当本轮以 --subagents/DEERFLOW_SUBAGENTS=true 启动时生效。留空=用 config.yaml 值
# DEERFLOW_RESEARCH_TIMEOUT 优先级（T6.6）：显式设置 > 上面留空时的深度档位（DEERFLOW_DEPTH_BUDGETS）
# DEERFLOW_DEEP_OPENING_RECURSION_LIMIT=400  # deep 首轮定向调研预算（Config 单一真源，下发给子进程；CONF-1 220→400 与扇出/双轨默认开配套）；通常无需改
# DEERFLOW_DUAL_TRACK=true            # 研究阶段「同时」跑两套工作流：Track A=deep-research→research_report.md（广覆盖证据报告，角色不变）+ Track B=actor-ontology-research→actor_dossier.md（actor 卷宗）。卷宗作为「主」actor 来源喂本体生成/抽取，报告作为「附加上下文」增强图谱/本体/人设/情势。默认开；关闭或 Track B 失败/空时行为与现状逐字节一致（单跑 Track A，不落 actor_dossier.md）。开启后研究阶段 LLM 成本约翻倍。仅 legacy 研究引擎生效：RESEARCH_ENGINE=v3 不产出 Track B 卷宗/封印的 actor-intelligence 平面，准入时 actor 策略钉为非必需并披露原因（research_engine_v3_emits_unsealed_actor_plane）
# ACTOR_DOSSIER_JUDGE=true            # Track B 合成后跑 8 维 AI-judge→定向 refine 环（SKILL §7-8 规定但此前从未执行）；默认开（NEXTSTEPS P3-1）
# ACTOR_DOSSIER_JUDGE_MAX_ROUNDS=2    # judge 判不合格时最多做几轮定向 refine（每轮=一次研究回合+重合成；成本护栏）。RQ-3 默认 1→2。
# RESEARCH_REPORT_JUDGE=true          # RQ-3：Track A 研究报告合成后跑 7 维 INSIGHT-CONTRACT AI-judge→定向 top-up→重合成环（论点具体性/基率/机制链/量化密度/反共识/长度达标/引用覆盖）；judge 路由走 DEERFLOW_JUDGE_MODEL；仅对 deep 生效；解析失败/异常→发当前稿（degrade-safe）。默认开。
# RESEARCH_REPORT_JUDGE_MAX_ROUNDS=1  # 研究报告 judge 判不合格时最多做几轮定向 top-up+重合成（成本护栏；每轮=一次研究回合+一次合成）。
# RESEARCH_REPORT_JUDGE_STRICT=false  # =true 时把研究报告 PASS 标准升级为全 7 维 ≥4（默认只要四关键维 ≥4 + 无维 <3 + 均分 ≥4）。
# DEERFLOW_REPORT_REFINE_RECURSION_LIMIT=360  # RQ-3 报告 refine top-up 研究回合的步进预算（护栏）。
# —— 深度研究引擎选择（deep-research engine v3）——
# RESEARCH_ENGINE=v3                  # 研究引擎：v3（默认）| linear（v3 的别名，兼容旧 .env）| legacy（旧 LangGraph 多 pass 引擎；别名 deerflow / agentic）。未知值按 v3 运行并告警一次。编排器把规范化后的值经 env 显式下发给研究子进程（--evidence-only / --synthesis-manifest 等外轨/全局综合契约始终走 legacy）。v3 在引擎内部做有界并行扇出（按 KIQ 的并行子代理共享来源台账、查询去重与提示缓存前缀），故 v3 下 RESEARCH_PARALLEL_TRACKS>1 被忽略、只跑 1 条外层研究轨；legacy 下多轨/全局综合行为与之前逐字节一致。
# —— v3 引擎旋钮（deerflow 子进程内的 linear_research.py / research_gateway.py 经 env 读取；全部留空 = 按研究深度预设）——
#   预设按 DEERFLOW_RESEARCH_DEPTH 选取（quick / standard / deep）；显式设置任一旋钮会对所有深度生效。下列示例值为 deep 预设。
# RESEARCH_LINEAR_MAX_KIQS=10          # 关键情报问题（KIQ）上限：quick 4 / standard 7 / deep 10
# RESEARCH_LINEAR_AGENT_MAX_STEPS=9    # 每个 KIQ 采集代理的工具步数上限：quick 5 / standard 7 / deep 9
# RESEARCH_LINEAR_SEARCHES_PER_KIQ=5   # 每个 KIQ 代理的 web_search 上限：quick 3 / standard 4 / deep 5
# RESEARCH_LINEAR_FETCHES_PER_KIQ=6    # 每个 KIQ 代理的 web_fetch 上限：quick 3 / standard 4 / deep 6
# RESEARCH_LINEAR_MAX_SEARCHES_TOTAL=140  # 整轮 web_search 总上限（运行级去重的重复查询不计）：quick 30 / standard 70 / deep 140；未显式设置时自动抬到本轮排程所需（侦察 + 种子 + 各 KIQ/补查代理配额）；显式设低于排程时缺口补查轮按剩余工具预算裁剪或跳过
# RESEARCH_LINEAR_MAX_FETCHES_TOTAL=110 # 整轮 web_fetch 总上限（已抓页面复读不计）：quick 24 / standard 50 / deep 110；排程抬升与补查裁剪规则同上
# RESEARCH_LINEAR_GAP_ROUNDS=2         # 覆盖缺口补查轮数（best-effort）：quick 0 / standard 1 / deep 2
# RESEARCH_LINEAR_FOLLOWUPS_PER_ROUND=4  # 每轮缺口补查的追加 KIQ 数上限：quick 0 / standard 3 / deep 4
# RESEARCH_LINEAR_SECTIONS_MIN=11      # 报告正文章节数下限（不含执行摘要/References）：quick 6 / standard 8 / deep 11
# RESEARCH_LINEAR_SECTIONS_MAX=16      # 报告正文章节数上限：quick 8 / standard 12 / deep 16
# RESEARCH_LINEAR_TARGET_UNITS=11000   # 报告目标长度（英文按词；中文按字 = 1.8× 词数）：quick 3000 / standard 6000 / deep 11000
# RESEARCH_LINEAR_CRITIQUE=1           # QA 后的建议性自我批评 + 至多 3 节改写（1/true/yes/on 开）：quick 0 / standard 0 / deep 1
# RESEARCH_LINEAR_BUDGET_UNITS=5000000 # 加权 token 预算（未缓存输入 1.0、缓存读/输出按提供方计价折算）：quick 1200000 / standard 2500000 / deep 5000000；采集阶段为综合保留份额，耗尽时跳过可选步骤并用已有证据成稿
# RESEARCH_LINEAR_TIME_BUDGET_S=5400   # 引擎墙钟预算（秒）：quick 1200 / standard 2700 / deep 5400；另被封顶为 0.85 × DEERFLOW_RESEARCH_TIMEOUT（编排器对 v3 下发的是实际生效的看门狗预算），保证 SIGKILL 前落盘报告
# RESEARCH_LINEAR_WORKERS=4            # 引擎内并行度（KIQ 代理/分节写作扇出）：各深度均为 4；另受编排器下发给子进程的模型并发信封（RESEARCH_GLOBAL_MODEL_CONCURRENCY 推导）封顶
# RESEARCH_LINEAR_DIGEST_CAP=90000     # 分节写作共享的证据摘要（digest）字符预算，按 KIQ 平分：每个 KIQ 块 = min(12000, max(3000, 预算/KIQ 数)) 字符，超出时先丢低优先级行（决定每次写作调用中证据摘要的体积）：quick 30000 / standard 60000 / deep 90000；范围 5000–400000
# RESEARCH_LINEAR_MAX_TOKENS_AGENT=6000   # 单次调用输出 token 上限：采集代理步
# RESEARCH_LINEAR_MAX_TOKENS_JSON=16000   # 单次调用输出 token 上限：结构化 JSON（规划/缺口/抽取）
# RESEARCH_LINEAR_MAX_TOKENS_WRITE=20000  # 单次调用输出 token 上限：分节写作/执行摘要（被截断时以 2 倍上限重试一次，至多 32000；仍截断则只发布完整段落/句子并由 QA 标记）
# RESEARCH_LINEAR_MAX_TOKENS_EXTRACT=32000  # 单次调用输出 token 上限：成稿后的 actors/facts 结构化抽取（不低于 MAX_TOKENS_JSON；被截断时以 2 倍上限重试一次，至多 64000；仍截断则保留已完整部分并在 meta 标记 actors_truncated / facts_truncated）
# RESEARCH_LINEAR_TIMEOUT_AGENT=240       # 单次调用超时（秒）：采集代理步；每次调用都会被裁剪到所在阶段截止时间的剩余时长（至少 30 秒）
# RESEARCH_LINEAR_TIMEOUT_JSON=360        # 单次调用超时（秒）：结构化 JSON（规划/缺口/抽取）
# RESEARCH_LINEAR_TIMEOUT_WRITE=600       # 单次调用超时（秒）：分节写作/执行摘要
# RESEARCH_LINEAR_GLM_EFFORT_AGENT=low    # 仅 GLM：reasoning_effort（low | high | max）——采集代理步。GLM 恒开思考且默认 max，输出/时延代价极高，故显式压档
# RESEARCH_LINEAR_GLM_EFFORT_JSON=low     # 仅 GLM：reasoning_effort——结构化 JSON 调用
# RESEARCH_LINEAR_GLM_EFFORT_WRITE=high   # 仅 GLM：reasoning_effort——分节写作（质量优先）
# RESEARCH_VERIFIED_FACTS=true        # v3: check each quantitative.json row's number against the fetched page of its cited source; adds verification (verified | unverified | snippet_only | none; snippet_only = source never fetched or its stored page unavailable, snippet not checked; absent = unchecked: no checkable number on a fetched page) and a verified bool, never changes values; zero model calls. REPORT-7: the same knob publishes evidence windows (the page sentence stating a verified figure next to >= 2 of its metric words, <= 360 chars, <= 2 per figure, <= 8 per source with every figure's best window first; windows over the cap are counted in windows_dropped) as sources.json supports, keeps quant source_ref, adds evidence_window / future_dated, and writes handoff verified_facts.json (drf.verified_facts/v1, SHA-manifested). false = every research artifact byte-identical. The orchestrator forwards it to the v3 child.
# RESEARCH_QUANT_TYPING=false         # v3: type quantitative rows reported/projected (epistemic_class, date_precision, target-date repair when as_of_date holds a forecast target), bucket future-dated rows as future_dated instead of fresh in meta.quant_freshness, and add a date-semantics rule to the facts prompt. Off = byte-identical; needs a live A/B before the default flips. Forwarded to the v3 child.
# RESEARCH_QUANT_RECONCILE=true       # TIME-4 quantitative sanity checks (every engine): quantitative rows on the same metric and unit (v3: also the same period end and length, geography and reported/projected class, but not the series name, so two entities' readings of one generic metric can still reconcile) that disagree by > 10% become contested.json claims (origin quant_reconcile; v3 adds at most 10, probable unit-scale errors first, actors.json keeps the extracted claims), a ~1000x gap is also a probable unit-scale error in meta.quant_unit_warnings, and claimed actuals dated after the research as-of (v3: also those whose as_of_date the bridge cannot read, or for a period ending after it) or with > 150% growth are listed in meta.quant_implausible (v3: rows typed reported or future_dated_reported, else value_type actual or absent; each meta list <= 20, meta.quant_sanity_truncated keeps the totals). Read-only: quantitative.json never changes. The legacy engine always ran them (its full run lists quant_implausible regardless of this knob); this restores them in v3 and the extract-only salvage. Parsed like the bridge (blank = true, else 1/true/yes/on); false = v3 and extract-only artifacts and meta byte-identical to before. Forwarded to every research child
# QUANT_TYPED_RENDERING=false         # RESEARCH-5: render RESEARCH_QUANT_TYPING's stamps on the report side: a persona's projected/unknown quantitative fact gets "(expectation by {source}, target {period})" (", as of {date}" when the row states only the source's date) and chart labels read epistemic_class first (projected -> forecast marker, reported -> actual). Off = byte-identical role prompts and charts; on changes role-prompt SHAs (PREPARE recomputes them).
# RESEARCH_FORECASTER_ATTRIBUTION=false  # RESEARCH-6 v3: the facts prompt asks estimate/forecast/target rows for their forecaster (also written to analyst, so charts split by forecaster, not publisher) with a forecaster-free metric, plus the low/high range and n_forecasters the report states; a bound is kept only when its numbers are the report's, a count only next to a count noun ("40 economists", "n = 40", "40位经济学家"), a value written as a range becomes low/high (range_kind stated_range), actual rows never carry these keys; meta.forecaster_attribution counts kept and dropped fields. Off = byte-identical facts prompt, quantitative.json and meta; on adds ~5-10% extraction output and changes which quant rows match an actor in PREPARE context packs (a row that matched still matches, but at the 32-row pack cap forecaster matches can displace later rows). Forwarded to the v3 child.
# RESEARCH_AS_OF_PIN=true             # TIME-1 honesty fix: v3 actors.json as_of_date is always the plan's as-of (UTC date fixed at plan time); a different value from the actor-extraction model is recorded in meta.json as_of_model_disagreement and never adopted (it anchors graph valid_at and the sim calendar). Fails closed: only 0/false/no/off disable it. false = the model's YYYY-MM-DD value is adopted as before. Forwarded to the v3 child.
# HINDCAST_ENABLED=false              # TIME-7 hindcast admission: accept as_of (canonical YYYY-MM-DD, not in the future) on /api/research/run, /api/v1/run and PipelineOrchestrator.start; requires RESEARCH_ENGINE=v3. An admitted run pins hindcast_policy_v1 and an evaluation-run pin (eval_run_id hindcast_YYYYMMDD: evaluation ledger, no production calibration), runs v3 research with RESEARCH_AS_OF (brief dated as_of plus a point-in-time rule, fetched pages labelled LIVE PAGE) and prediction markets withheld, and anchors the graph at the pinned date (later-dated sources recorded in hindcast_violations, never adopted; hindcast_source_dates counts dated/undated sources, since v3 dates them only with RESEARCH_SOURCE_DATES). A research timeout that leaves no actors.json dated to the pin fails the stage (resumable) instead of running the legacy extract-only salvage. Characterization-only. false = any request carrying as_of is rejected (400 / ValueError), never run live.
# PIT_GATES=true                      # TIME-8 point-in-time evidence gates of a hindcast's v3 research, pinned at admission into hindcast_policy_v1.pit (a later config change never alters an admitted run) and effective only inside a pinned hindcast (live runs unaffected). The parent passes the pin to the v3 child as RESEARCH_PIT_GATES/SAME_DAY/UNDATED/PROVIDER_BOUNDS/OVERFETCH and forces RESEARCH_SOURCE_DATES=true (ambient RESEARCH_PIT_* values never reach a child). A source is available on the latest day consistent with its latest publication/update date (a month/quarter/year counts as its end); late search rows are dropped before they get an [S<n>] id (all late = NO_IN_WINDOW_RESULTS, "not evidence that nothing happened"), URL-dated-late fetches are refused without budget, late pages are withheld (FETCH_WITHHELD) before storage, and each verdict is recorded as the ledger pit_status and counted in meta.tools.pit. TIME-9: the report then cites only sources admissible as of the as-of (References, sources.json and the writers' evidence digest are filtered), the research writes point_in_time.json (the gates' counts plus an independent date re-check of the cited sources) and its verdict is stamped into the pin before the report: forecast.json hindcast.integrity date_verified / date_verified_with_unverifiable / leak_suspected, run.json as_of_enforcement.retrieval_clamped. Only 0/false/no/off disable it
# PIT_SAME_DAY_POLICY=exclude         # TIME-8: exclude (strict: a source available on the as-of day itself is late) | include (admitted, labelled same-day). Other values = exclude
# PIT_UNDATED_POLICY=drop             # TIME-8: a fetched page with no readable date: drop (withheld as FETCH_WITHHELD(pit_undated); can starve undated data pages) | flag (stored with pit_status unverifiable, labelled undated). Undated search rows are always shown, labelled undated. Other values = drop
# PIT_PROVIDER_DATE_BOUNDS=true       # TIME-8: gated searches ask the provider for a date bound at the as-of (Firecrawl tbs cdr:1,cd_max:M/D/YYYY; Serper/Tavily/DDG cannot and are counted unbounded; a bounded request Firecrawl rejects with HTTP 400/422 is retried once unbounded and the bound stays off for that process). Gated search cache entries are keyed apart from live ones (and bounded from unbounded) either way, and the row gate always runs. Only 0/false/no/off disable it
# PIT_SEARCH_OVERFETCH=1              # TIME-8: rows requested per gated search = 5 x this (clamped 1..4) so late rows can be dropped without starving the 5 render slots; Firecrawl still caps billed rows at RESEARCH_FIRECRAWL_SEARCH_LIMIT
# RESEARCH_LINEAR_MODE=               # 旧 linear v2 旋钮。v3 忽略 salvage 语义：绝不采纳非本引擎产出的既有 research_report.md；设为 salvage 仅等价于「续跑 v3 自身已持久化的阶段」（身份 = 问题/深度/模型/语言/引擎版本 匹配时 v3 本就总会续跑），设置时只记一条日志
# RESEARCH_FETCH_SHELL_DETECTION=true  # RESEARCH-1 honesty check: reader shells ("Markdown Content: undefined"), "page unavailable" pages, bot walls and short paywall teasers are failed fetches — never cached, they trigger provider failover, the v3 tool layer answers FETCH_FAILED(<reason>) and never marks them fetched, and a shell stored before the check (resumed work dir) no longer counts as fetched and is published as cited (fetch_status=shell:<reason>). Fails closed: only 0/false/no/off disable it (blank, 1/yes/on or a typo keep it on). false = previous shell handling byte for byte (the direct-fallback PDF parser fix is unconditional)
# RESEARCH_FETCH_CALL_TIMEOUT_S=150   # RESEARCH-1 hard wall-clock bound (seconds) of one v3 web_fetch; on expiry the fetch returns FETCH_FAILED(fetch_call_deadline_exceeded) (not retried) without waiting for leftover executor threads. Successful fetches are unchanged; 0 = the previous asyncio.run path
# RESEARCH_EVIDENCE_QUOTES=off        # RESEARCH-7 verbatim evidence spans for v3 findings: off | audit | enforce. Not off: the KIQ task asks each finding to end with EVIDENCE: "<passage copied verbatim, 8-60 words>", the source ledger keeps every distinct snippet of a row, and each quote is located deterministically (zero model calls; exact, normalized or ordered elided segments) in the cited sources' stored pages / search text; KIQ facts get evidence, evidence_status (verified | failed | absent), evidence_near_miss, claimed_tag and a REPORTED-number audit (number_check, telemetry only), meta.json gets evidence and an [evidence] progress line per KIQ. audit changes no tag; enforce demotes facts whose quotes are not on what the agent was shown (UNVERIFIED, evidence_not_on_page) and VERIFIED facts whose numbers lie outside the quoted passages (REPORTED, numbers_outside_evidence), and flags a run where under half of the claimed-VERIFIED findings have a located quote. Off = byte-identical; blank/unknown = off; enforce only after an owner-approved audit run (located share >= 0.8, QA passing). Forwarded to the v3 child
# RESEARCH_EVIDENCE_SUPPORTS=false    # RESEARCH-7: with RESEARCH_EVIDENCE_QUOTES not off, up to 3 located verbatim quotes per source (<= 280 chars, page quotes first) become its sources.json supports ahead of the REPORT-7 evidence windows. Changes the report's semantic-citation / quote-grounding inputs, so measure the gate delta in an audit run first. false = supports as before. Forwarded to the v3 child
# RESEARCH_SOURCE_TAXONOMY=false      # RESEARCH-2 typed source outcomes: search budget denials no longer count as fetch failures; a Firecrawl 401/402 on search latches the v3 run (SEARCH_NOT_CONFIGURED, zero further backend calls) and on fetch disables Firecrawl for the process and opens the shared provider circuit; outages never enter the gateway run cache or the fetch negative cache; DDG "No results found" becomes SEARCH_EMPTY_UNCONFIRMED; fetch failures read FETCH_UNAVAILABLE (service) or FETCH_FAILED (page); writes meta.source_health. Off = byte-identical; needs a live comparison run before the default flips. Forwarded to every research child
# RESEARCH_ABSENCE_DISCIPLINE=false   # RESEARCH-3 v3 absence discipline: an empty web search answers NO_RESULTS plus "Results are relevance-ranked and undated: an empty search is not evidence that something did not happen.", the KIQ task and the section rules each gain one line (state that something did not happen or was not reported only when a cited source says so; otherwise an open question / "the sources reviewed do not establish it"), and findings stating an absence are counted by tag in KIQ records (absence_cues) and meta.json (absence_findings: total, VERIFIED, REPORTED, UNVERIFIED) with no tag change. Off = tool text, prompts, records and meta byte-identical; needs a live comparison run before the default flips. Forwarded to the v3 child
# RESEARCH_QUESTION_SPEC=false        # RESEARCH-11 v3 question spec: one post-scout JSON call (reusing the plan call's cached prefix) pins the operational question, outcome definition, resolution source (name/url/kind), horizon (label/date/basis; date kept only in (as_of, as_of+30y]) and reference class, and discloses at most 3 defaults it chose instead of asking (most important slot first). Written to handoff question_spec.json (drf.question_spec/v1, spec_sha256, SHA-manifested) before gathering, appended to the run brief, fed to the plan call (scenarios partition the spec's outcome; one KIQ establishes the reference-class base rate) and mirrored into actors.json (question_spec, horizon_date, forecast_inputs.base_rates). A failed call never fails the run: status unavailable + a degradation event. Off = brief, plan, actors.json and every prompt byte-identical. Forwarded to the v3 child
# QUESTION_SPEC_DOWNSTREAM=true       # RESEARCH-12 backend consumers of a valid actors.json question_spec (schema drf.question_spec/v1, status ok/partial, spec_sha256 recomputed; anything else is ignored): the simulation calendar horizon below every deterministic prompt date (skips the LLM fallback; horizon_source question_spec) and the world-state seed's horizon fallback, a spec block first in the spine prompt's research inputs (only when the spec's deadline is the run's horizon: an explicit prompt date or an out-of-window day keeps it out, and forecast.json records horizon_applied=false), an operational-definitions/assumptions subsection in the report's resolution section and forecast.json question_spec. No spec (needs RESEARCH_QUESTION_SPEC) = byte-identical; false = shadow mode (persisted, unused)
# RESEARCH_V3_CITATION_STATS=true    # RESEARCH-9 v3: the QA phase writes qa.json citation_stats (v3-citation-stats/1: markers before QA and published, orphan markers renumbering dropped (occurrences, distinct, sample), stale citation groups, cited fetched vs snippet sources and the snippet marker share, unused fetched pages, writer bibliographies and scaffold echo lines detected, prose numbers no VERIFIED/REPORTED finding, cited page or cited snippet traces), mirrored into meta.research_qa and meta.research_quality. Detection only: research_report.md and sources.json byte-identical; false = no key. Forwarded to the v3 child
# RESEARCH_V3_FORECAST_INPUTS=false   # RESEARCH-11 v3: the facts extraction also asks for forecast drivers and dated leading indicators (precision-preserving dates, never padded) that fill actors.json forecast_inputs.drivers / .indicators (v3 wrote them empty). Needs RESEARCH_FORECAST_INPUTS=true too. Off = facts prompt and actors.json byte-identical; needs one live A/B before the default flips. Forwarded to the v3 child
# RESEARCH_SOURCE_DATES=false         # TIME-2 v3 source publication dates: provider metadata (Firecrawl scrape metadata and search row dates, Exa published_date, direct-fetch JSON-LD/<meta>/<time>), then page-head datelines and URL paths, converted to the UTC calendar with precision and provenance; future and pre-1900 dates rejected. Shown in tool row headers, the SOURCE INDEX and References; written to sources.json (date, date_precision, date_source, modified_at, modified_source, date_rejected), quant rows (source_date, as_of_after_source: an actual value dated after its source; only a metadata modified date widens that window) and meta.source_dates. Zero model calls. Off = byte-identical research artifacts (the fetch cache still records provider date metadata, so a later flag-on run dates cache hits); needs a precision check on real pages before the default flips. Forwarded to the v3 child
# RESEARCH_SOURCE_DATE_TEXT_FALLBACK=true  # TIME-2: with RESEARCH_SOURCE_DATES on, also date sources from heuristics ranked below metadata: fetched pages' head datelines (Published/Updated/发布时间) and the URL path of fetched pages and search rows. Off = only provider/HTML metadata and search-provider row dates. Only 0/false/no/off disable it. Forwarded to the v3 child
# DATA_TOOLS_CACHE_DIR=               # TIME-10 official-data vendor tools (deerflow_bridge/data_tools.py, inert until the research engine binds it): cache directory for successful FRED/ALFRED fetches, one JSON file per sha256(fred|ID|vintage|as_of|window), atomic writes, failures never cached, never holds the API key. Empty = <bridge module dir>/.cache/data_cache
# DATA_FRED_CACHE_TTL_H=6              # TIME-10: hours a fetch at today's vintage (still open: FRED may publish later that day) stays cached; a vintage before FRED's today (America/Chicago) is kept 30 days. Read at every lookup, so a lowered value also shortens entries already cached. 0 = do not cache today's vintage; clamped to 0-720, unparseable = 6
# DATA_TOOL_TIMEOUT_S=20               # TIME-10: per-request HTTP timeout (seconds) of the official-data vendor tools; clamped to 1-120, unparseable = 20
# DATA_FRED_WINDOW_YEARS=10            # TIME-10: FRED observation window (years before as_of, 29 Feb safe); clamped to 1-40, unparseable = 10

# ===== EXECPLAN 结构化契约旋钮（研究→图谱→模拟→报告 的"黄金线"；全部有安全默认，留空即保持当前行为）=====
# —— 图谱（Phase 2）——
# GRAPH_SEED_FROM_ACTORS=true          # 文本抽取前把研究确认的 actors+relationships 作为 typed 边种入图谱（T2.2）
# GRAPH_BUILD_CONCURRENCY=4            # parallel episode extraction (was 1); takes the concurrent fan-out path. REQUIRES GRAPH_RESOLVE_ENTITIES=true.（GRAPH-1）
# GRAPHITI_MAX_COROUTINES=16          # intra-episode per-node/edge LLM fan-out (graphiti default 20; was effective 8). runtime.py reads via env.（GRAPH-3）
# GRAPH_LLM_EXECUTOR_WORKERS=64       # dedicated thread pool for blocking graphiti LLM HTTP I/O; unlocks the concurrency knobs the shared cpu+4 default pool (~20) caps.（R2-EXEC-1）
# EMBED_EXECUTOR_WORKERS=4            # separate small compute pool for SentenceTransformer encode so embedding stops stealing LLM I/O threads.（R2-EXEC-2）
# EMBED_DISK_CACHE_PATH=uploads/graphiti_db/embed_cache.sqlite  # persistent write-through embedding cache keyed by (model,normalized_text); survives resumes/seeds. 留空=GRAPHITI_DATA_DIR/embed_cache.sqlite（R2-EXEC-5/GAP-2）
# GRAPH_MAX_NODES=8000                # cap for zep_paging node reads (was hardcoded 2000); a ~400-episode corpus exceeds 2000 and silently truncates centrality/agent pool.（GRAPH-6）
# GRAPH_RESOLVE_ENTITIES=true          # （GRAPH-4/GRAPH-1，必须与上面 concurrency 配对；详见下方「实体消解」块）
# GRAPH_BUILD_COMMUNITIES=false        # ⚠️ 默认关（KG-4，与 config.py 一致）：graphiti_core 的 label_propagation（while True）在部分拓扑上不收敛 → 100% CPU 同步卡死后台事件循环、拖垮建图后所有读取（实测 900s 超时级联）。上游修复收敛性前请保持关闭（NEXTSTEPS P3-9 / T2.4）
# GRAPH_CENTRALITY_PRIORS=true         # 把建图算出的度数中心度作为影响力先验融入 agent-cap 的 salience 排序；默认开，无先验时 no-op（NEXTSTEPS P3-7）
# GRAPHITI_REMOTE=false                # 远程 Graphiti/Zep 才需分批限流停顿；本地 FalkorDB 关闭死延迟（T2.6）
# GRAPHITI_OP_TIMEOUT_S=900            # per-graphiti-op wall cap (was 1800). Fast-tier + fewer episodes keep per-batch well under 15min; fails a wedged read fast.（GRAPH-9）；0=不设上限
# —— 模拟（Phase 3）——
# OASIS_DEFAULT_MAX_ROUNDS=36          # global round cap (was 0=unbounded, up to 336). options.max_rounds still overrides for long horizons.（SIM-2）
# —— 日历时间轴模式（TEMPORAL-*；仅影响 config 生成，运行侧按 temporal_config 是否存在分派）——
# SIM_TEMPORAL_MODE=calendar           # calendar（默认）=每轮对应一个自然日历时段（日/周/半月/月/季/半年），事件按真实日期落轮、
#                                      # 预测期限完整覆盖；hours=不生成 temporal_config，走旧小时制路径（字节不变）
# SIM_CALENDAR_TARGET_MAX_ROUNDS=36    # 日历单位选择的软轮数预算（在预算内取最接近理想轮数的时间粒度；只粗化粒度，不截断预测期）
# SIM_CALENDAR_HARD_MAX_ROUNDS=48      # 绝对轮数上界（短时域反锯齿细化的天花板）
# SIM_HORIZON_DEFAULT_MONTHS=12        # 问题中解析不出预测期限（确定性各档+LLM 兜底均失败）时的降级默认时域（月）
# SIM_WORLD_DELTA=true                 # 世界时钟头部附带上一时段变化摘要（纯确定性拼装，无数值份额外泄；仅日历模式生效）
# SIM_ABSENCE_MARKERS=true             # 世界时钟空段区分首轮/平静期/摘要不可用/本次不产出/本时段无日程事件（取代一律 "(first period)"/"(none)"）+ 轨迹 delta_state_counts；false=逐字节旧行为
# SIM_PERIOD_CONTEXT_V2=true           # SIM-6 逐时段上下文如实送达：事件段标「预期事件，结果事先未知」（不再称 CONFIRMED）+ 情景注入标 SCENARIO ASSUMPTION、摘要落后注明覆盖时段、缺席事件轮的 sampled agent 首次激活补报、死轮事件并入下一次摘要、摘要分段整行封顶、回应阶段辅助 agent 拿到本期上下文；false=agent 可见文本逐字节旧行为
# SIM_EVENT_CATCHUP_MAX_CHARS=1200     # SIM-6 漏报事件补报块字符上限（整行、最新优先，超出以 "(+N earlier scheduled events omitted)" 标注）
# SIM_DECISION_CHANNEL_INBAND=true     # 决策通道逐轮在环内引出承诺并推进 WorldState（仅日历模式；关闭=回退事后一次性通道）
# WORLDSTATE_ENTROPY_MIX=true          # WorldState.step 熵地板：按时段天数向种子基率先验混合，防长时域份额锁死（仅日历模式生效）
# OASIS_MAX_AGENTS=80                  # 智能体上限；超过按(匹配actor,影响力,邻边数)排序保留，始终保留研究 actor（T3.13）
# ACTOR_CAST_MAX=20                    # 主角色阵容硬上限（actor-cast discipline）：只保留决策/行动会因果性影响预测结果的 main actors；
#                                      # 贯穿研究抽取（actors.json 截断+meta.actors_truncated_from）、本体提示词与模拟 agent 池。
#                                      # 80→20 personas cuts profile + per-round sim LLM calls ~4x. 设 ≥ OASIS_MAX_AGENTS 恢复旧「填充到80」行为
# ACTOR_EXCLUDE_MEDIA=true             # 媒体/观察者降级为 context：媒体机构/记者/评论员/分析师/智库不是能动 actor（推断 tier=3，
#                                      # 被 tier 1/2 准入门挡在 agent 池外；显式 simulation_tier/archetype 标注优先）。false=旧行为全放行
# SIM_AUDIENCE_AGENTS=0                # 主阵容之外的程序化「受众/填充」persona 数（沉默大多数，无逐个 LLM 成本）；默认 0=池子只含主阵容
# SIM_AUDIENCE_SIZE=                   # 上一行的旧名兜底别名（I-2-2；仅 SIM_AUDIENCE_AGENTS 未设时读取）；新配置请用新名
#                                      # （此前池子被图谱通用节点填充到 ~80）。兼容旧名 SIM_AUDIENCE_SIZE（I-2-2）
# SIM_ACTIVITY_PROFILE=china_social    # 人设活动节律/时区预设：china_social（默认=北京作息，与现状一致）| us_business | global_market（T3.x）
# SIM_TWITTER_RECSYS=reddit            # QUALITY-OPT S8：Twitter 推荐器默认改用「免模型」的 reddit 档（按热度+时序排序），
#                                      # 取代需在线下载 twhin-bert-base 的 twhin-bert/twitter 档（下载失败→空 feed→0 评论/0 点赞的广播态）。
#                                      # 可选 reddit | random | twhin-bert | twitter（后两者需先缓存 HF 模型 + HF_HUB_OFFLINE=1）。twitter_config.recsys_type 显式设置时优先。
# SIM_GRAPH_FEEDBACK=false             # Foglamp WP1 (1A/I-11)：模拟→观察图反馈默认【关】。旧默认开会把去除模拟前缀的合成活动写进观察图，下游把它当事实检索（epistemic 污染）。WP10 隔离 overlay 就绪前不得开启；true 仅限特征化 fixture/一次性隔离图（T3.10→WP1）
# SIM_TYPED_FEEDBACK_EDGES=false       # 同上：typed 边反馈默认【关】（A LIKED/REPLIED_TO/FOLLOWED B）（T3.10→WP1）
# SIM_INTERVIEW_GRAPH_FEEDBACK=false   # Foglamp WP1 (1A)：终局采访写观察图单独设门，默认【关】；采访全文仍保留在 run 产物（T3.14→WP1）
# SIMULATION_FORECAST_EFFECT=diagnostic_only  # Foglamp WP1 (1D/I-16)：模拟对已发布概率的影响政策：diagnostic_only（默认，模拟产出只进显式标注的分析散文，不进概率生成）| no_update（连诊断散文也不注入）| validated_update（WP6/12/14 晋升后才可用，当前回落 diagnostic_only）| legacy_prompt（仅特征化 fixture）
# SIM_WIRE_RECSYS=false                # 把 *_config 的 recsys 旋钮映射到 oasis Platform；默认关=DefaultPlatformType（T3.12）
# SIM_TIER_ELIGIBILITY=true            # 智能体池按 is_agent_eligible() 收敛（仅 actor/collective 入池，记者/媒体/概念不入池）；默认开，无 archetype/simulation_tier 时 no-op（保留全部，与现状一致）
# SIM_SALIENCE_RANKING=true            # 智能体上限裁剪按 salience_score() 排序；默认开，salience 缺失时回退到 (匹配actor,影响力,邻边数) 元组（与现状一致）
# SIM_VALENCED_RELATIONS=true          # 关注图+情感用关系 valence/polarity（盟友≠对手≠交易方）；默认开，仅新增关系类型生效，既有 8 类 legacy 关系与现状逐字节一致
# —— 报告（Phase 4）——
# REPORT_AGENT_SECTION_MAX_TOKENS=32768 # 章节正文生成输出 token 上限（OpenAI 兼容提供方生效）；此前硬编码 8192 会截断长章节，默认提升到 32768（gemini-3.5-flash 等 65536 输出上限模型可写更完整章节）
# REPORT_AGENT_TOOL_TURN_MAX_TOKENS=8192 # smaller completion budget for intermediate tool-selection turns; final-answer turn keeps REPORT_AGENT_SECTION_MAX_TOKENS (32768).（REPORT-9）
# REPORT_AGENT_MAX_TOOL_CALLS=12       # 每章节最多工具调用（成本/深度旋钮；RQ-1 8→12，小 page_budget 报告经 derive_report_shape 收敛回 8）（T4.4）
# REPORT_AGENT_MIN_TOOL_CALLS=4        # 每章节最少工具调用（保证实证密度）（T4.4）
# REPORT_SECTION_TARGET_CHARS=3000-6000 # RQ-1 每章正文目标字数区间 'lo-hi'（模板进 SECTION 提示词）；旧值 1800-2800，小 page_budget 报告收敛回旧值。解析失败回退 3000-6000
# REPORT_SECTION_FLOOR_CHARS=2000      # RQ-1 每章正文硬下限字数（旧值 1500，小 page_budget 报告收敛回 1500）
# REPORT_AGENT_MAX_TOOL_CALLS_CHAT=2   # 对话模式最多工具调用（T4.4）
# REPORT_AGENT_TEMPERATURE=0.5         # 章节撰写温度（T4.4）
# REPORT_NATIVE_TOOLS=true             # native tool-calling instead of brittle regex ReAct; auto-falls back to ReAct per-section on exception.（REPORT-4）
# REPORT_TOOL_ARG_REPAIR=true          # tolerant <tool_call> parsing (first object of many, brace balancing, arguments/args/input aliases, flat args lifted into parameters) + pre-dispatch validation (required params, as_of, limit); malformed/invalid calls become corrective observations (native: role=tool ERROR replies) and do not consume tool budget; false = legacy strict parser, no validation (the native path's fail-closed unknown-tool rejection and the tool_unknown agent_log rows stay on).（INFRA-5）
# REPORT_TOOL_MAX_REJECTED_PER_SECTION=6 # rejected tool calls per section that stay free of tool budget; later rejections are charged so a model cannot loop on bad calls (charged rejections spend the max budget but never count toward the per-section minimum). Only applies with REPORT_TOOL_ARG_REPAIR=true; unknown-tool rejections are never charged.（INFRA-5）
# REPORT_NATIVE_FINAL_WITH_EVIDENCE=true # when the native tool loop runs out of iterations, the forced final prompt carries a digest of the tool results gathered so far instead of discarding them; false = legacy bare prompt.（INFRA-5）
# REPORT_NATIVE_FINAL_EVIDENCE_CHARS=12000 # head+tail character budget of that evidence digest (non-positive falls back to 12000).（INFRA-5）
# REPORT_SECTION_CONCURRENCY=6         # parallel body-section generation (REPORT-1 1→3, PAR-3 3→6); summary/conclusion still run last with full body; effective concurrency = min(this, body-section count).（REPORT-1 / PAR-3）
# REPORT_SECTION_CONTEXT_MODE=brief    # inject outline + per-section summaries instead of full prior sections (was full); kills O(N^2) re-transmission.（REPORT-2）

# ===== EXECPLAN2 旋钮（安全 / 可观测 / 缓存 / 预算；全部有安全默认，留空即保持当前行为）=====
# —— API 暴露面与密钥（Phase 0）——
# APP_API_TOKEN=                       # 设置后，非环回来源的 /api/* 变更请求需带 X-API-Token 头；留空=仅环回可达（fail-closed）（F-13-0）
# APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000  # 允许的 CORS 来源（逗号分隔）；'*' 恢复旧的全开行为（F-13-0）
# APP_BLOCK_PRIVATE_URLS=false         # 连通性测试/出站请求是否禁止私网/环回地址（暴露到环回之外时建议 true）（F-13-2）
# APP_HOST_CHECK=true                  # DNS-rebinding guard: loopback requests are trusted without a token only when the Host header is localhost/127.0.0.1/::1 (port ignored); only false/0/no/off disables it (legacy Host-agnostic trust) (INFRA-10)
# APP_ALLOWED_HOSTS=                   # extra comma-separated Host names accepted on loopback requests (e.g. a custom hosts-file alias); empty = built-in names only (INFRA-10)
# CONFIG_STRICT_VALIDATION=true        # config audit (backend/app/config_audit.py): a non-canonical boolean (X=1 is read as false), a blank/malformed number, an enum/range/coupled-pair violation or a malformed LLM_COST_PER_MTOK refuses pipeline runs (preflight + start); the server still starts and prints every issue as a WARN line; only false/0/no/off downgrades them to warnings (INFRA-14)
# LOG_LEVEL=INFO                       # 文件日志级别（INFO 默认；设 DEBUG 才记请求体——已脱敏）（F-13-1）
# SECRET_KEY=mirofish-secret-key       # Flask session 密钥；生产务必改为随机值
# —— LLM 可观测 / 缓存 / 预算（Phase 4）——
# LLM_TELEMETRY_ENABLED=true           # 记录每次 LLM 调用的 token/成本/延迟（按阶段/模型），落 run_telemetry.json（I-5-0）
# LLM_CACHE_ENABLED=true               # content-addressed reuse of byte-identical chat()/chat_json() (prepare/persona/config-gen across reruns/seeds/forks).（SIM-9/CACHE-1）
# LLM_TRANSPORT_STRICT=true            # strip orphan/dangling <think> reasoning from API replies and never cache length/content_filter/error or cut-reasoning replies; false = legacy regex strip + unconditional caching.（INFRA-1）
# LLM_JSON_REPAIR_TURN=true            # chat_json: a reply that is not one JSON object is dropped from LLMCache and re-asked once at the same temperature with the bad reply + a repair note (outcomes in telemetry structured_outputs); false = legacy blind retry at temperature-0.2.（INFRA-2）
# LLM_LENGTH_ESCALATION=true           # an empty reply cut by max_tokens (finish_reason=length, reasoning ate the budget) is re-sent at once with max(max_tokens x2, 1024), metered and budget-checked; exhausted -> straight to the fallback provider (outcomes in telemetry recovery); the report preflight reads such a reply as a reachable provider; false = legacy 3 backoff retries at the same max_tokens (and the preflight fails).（INFRA-3）
# LLM_MAX_ESCALATIONS=2                # at most this many max_tokens escalations per chat() call (0 = none: an empty length reply goes straight to the fallback provider).（INFRA-3）
# LLM_MAX_TOKENS_CEILING=32768         # largest escalated max_tokens when the provider's PROVIDER_META has no max_output_tokens; also clamped to context window - prompt - 1024.（INFRA-3）
# LLM_JSON_TRUNCATION_FAIL_CLOSED=true # forecast extraction fails closed on a truncated JSON reply (finish_reason=length or bracket-repaired): spine draw discarded, a binary / market-match / revision item the cut left incomplete dropped (the last item when the bracket repair cannot tell), critique/premortem return the input, post-hoc extraction flagged in quality.llm_truncation, the reply removed from LLMCache; false = legacy (truncated content accepted).（INFRA-3）
# LLM_RUN_BUDGET_TOKENS=0              # 每个 run 的 token 上限（0=不限）；超限下一次 LLM 调用抛 BudgetExceeded 止血（I-5-3）
# LLM_RUN_BUDGET_USD=0                 # 每个 run 的成本上限（USD，0=不限）（I-5-3）
# LLM_COST_PER_MTOK=                   # per-provider $/Mtok 成本覆盖（JSON，如 {"openai":[5.0,15.0]}）；叠加在内建默认之上，空=纯用默认（ITEM-18）
# LLM_SUBSCRIPTION_PROVIDERS=          # comma list of flat-rate plan providers (e.g. glm,minimax on a coding/token plan) labelled cost_basis=subscription like claude-cli; cost_usd stays the API-rate equivalent; empty = built-in CLI providers only (EVAL-17)
# REPORT_TELEMETRY_APPENDIX=false      # W9 默认改 false：Run Telemetry 附录表（stage×调用/tokens/成本/墙钟）改写到 <report_dir>/telemetry.md，不再默认追加进 full_report.md；true 恢复旧行为（ITEM-18/W9）
# LLM_HTTP2=true                       # tuned httpx client (HTTP/2 multiplexing, larger keepalive) for the sync OpenAI client; falls back to http1 on negotiation failure.（R2-EXEC-6）
# LLM_HTTP_KEEPALIVE=128               # max keepalive connections for the tuned LLM HTTP client (was 20).（R2-EXEC-6）
# LLM_HTTP_TIMEOUT_S=600               # hard per-call HTTP timeout (seconds) of the OpenAI-compatible LLM client, so a stream that dies mid-read cannot wedge a pipeline thread; 0 = 600 (INFRA-14)
# —— 报告：结构化预测（Phase 5 / NEXTSTEPS P0-1·P2-1·P2-3）——
# REPORT_STRUCTURED_FORECAST=true      # 机器可读预测对象（情景+概率+判定标准）+引用审计，落 forecast.json（默认开；NEXTSTEPS P0-1）
# —— QUALITY-OPT：二元预测契约 + 完成健康门 ——
# FORECAST_EMIT_BINARY=true            # 抽取/补足 >=N 条独立二元(yes/no)预测（含客观判定 指标·阈值·日期·来源），与情景并存写入 forecast['binary_forecasts']，并前置为报告 Part 1（默认开）
# BINARY_FORECASTS_MIN_COUNT=10        # 二元预测最少条数（briefs 常要求 >=10）
# FORECAST_BINARY_REQUIRE_SHARP=true   # 二元预测强制客观判定（指标 AND 数字 AND 日期），不达标逐条重生成
# REPORT_OUTPUT_LANGUAGE=              # 强制报告输出语言（如 English/Chinese）；留空=从 brief/研究报告自动侦测（英文 brief→英文）
# PIPELINE_HEALTH_GATE=true            # 收尾前校验真实交付物：报告全占位/无 forecast.json → 硬失败(status=failed)；空洞/截断的模拟 → 记 degraded 健康块。终结「假完成」（默认开）
# PIPELINE_HEALTH_RESEARCH_STAGE=false # RESEARCH-2: add pipeline_health.stages.research (health=degraded, first 8 degradation issues, score) when research_quality is degraded; the executive brief's honesty note then says "research degraded". Degrade-only, never fails the pipeline; off = no research stage (as before). Such a run completes with pipeline_health.status=degraded and so accepts a force resume, which only regenerates the report and cannot repair the research
# REPORT_FORECAST_SPINE_FIRST=true     # 在写章节叙事**之前**先从信号+forecast_inputs 推导预测骨架并注入每章提示词（默认开；NEXTSTEPS P0-1）
# REPORT_FORECAST_SELF_CRITIQUE=true   # 结构化预测后追加红队自校准（纠正过度自信/基率忽视）（默认开；NEXTSTEPS P2-1 / I-3-5）
# REPORT_PUBLISH_GATE=true             # 发布门：严格引用覆盖等认识论缺口至多降一级信心；概率不闭合/缺兜底/最终工件缺陷写 hard_issues 并阻止 completed；写 forecast.json.quality（默认开）
# REPORT_PUBLISH_GATE_MIN_COVERAGE=0.75 # 专业发布门要求的定量声明引用覆盖率阈值；低于阈值拒绝发布
# REPORT_MAX_CITATIONS_PER_SOURCE=20 # 单一来源正文引用上限；防止通用来源被重复套用到不相关论断
# REPORT_FINAL_READ_ONLY_AUDIT=true    # 引用最终化后审计精确成稿字节（SHA-256/磁盘一致性/悬空引用/语言与流程污染/lint would-change），只写 final_audit.json + forecast quality，绝不再次改正文
# REPORT_FINALIZATION_TELEMETRY=true  # RESEARCH-9: persist what the publish stabilizer did to citations before the read-only audit (markers_before/markers_final, dangling and semantic kept/remapped/stripped, overuse and quote strips, the quantitative repair's citations_added/sentences_removed/table rows and cells/coverage, marker_strip_ratio, markers_lost_with_removed_text) as final_audit.json pre_audit_repairs (report-citation-finalization/1) and forecast.json quality.citation_finalization; WARNING log at a strip ratio >= 0.5. Telemetry only: Markdown and gates unchanged; false = neither key
# REPORT_RESOLUTION_SECTION=true       # 报告末尾追加确定性「如何验证本预测」章节（逐情景判定标准+观察指标）并把指标-情景映射写进 forecast.json（NEXTSTEPS P2-2）
# —— 确定性报告可视化器（VIZ-1；无 LLM，把结构化工件渲染成 Mermaid + matplotlib PNG）——
# REPORT_VISUALIZER=true               # 主开关：渲染报告图表（Mermaid 代码块 + PNG），落 reports/{id}/charts/ + viz_manifest.json（默认开；关闭=不生成图）（VIZ-1）
# REPORT_VIZ_MERMAID=true              # Mermaid 族（零依赖）：时间线/因果路径/派系/角色关系网络（默认开）（VIZ-1）
# REPORT_VIZ_CHARTS=true               # matplotlib PNG 族：情景误差棒/模型vs市场哑铃/世界态堆叠面积/对比分组柱/校准曲线（默认开；matplotlib 未装则该族自动无效）（VIZ-1）
# REPORT_VIZ_DPI=160                   # PNG 渲染 dpi（PDF 宽度可读性，下限 72）（VIZ-1）
# REPORT_VIZ_MAX_NODES=40              # 网络/因果/派系图节点上限（防巨图不可读，超出确定性截断保留首现节点）；PM-6 亦用作价格历史锚点上限（VIZ-1）
# REPORT_VIZ_INTERACTIVE=true          # ITEM-16：交互式 plotly HTML 图表族——PNG 族的可交互等价物（情景误差棒/模型vs市场哑铃/市场价格历史折线/世界态堆叠面积），落 charts/*.html（plotly.js 内联、完全离线自包含），viz_manifest type='html'，经 /api/report/{id}/charts/<file> 以 text/html 服务；默认开；plotly 未装则该族自动无效（PNG/Mermaid 不受影响）（ITEM-16）
# REPORT_VIZ_PRICE_HISTORY=true        # PM-6：每个带市场锚点的二元预测画「市场隐含 P(yes) 历史价折线 + 模型概率水平参考线 + 分歧标注」，落 charts/market_price_history_*.png（placement_hint=binary_forecasts，Part-1 Market Cross-Check 区）；数据源 reports/{id}/ 或 handoff 的 market_price_history.json（{market_id:[{t,p}]}，缺则整族跳过）；默认开（PM-6）
# REPORT_VISUALIZATIONS=true           # VIZ-1 钩子：把生成的图表/图注注入成稿 full_report.md（Mermaid 按章节关键词就地插入，未匹配图+全部 PNG 归入「Visual Annex」）；与 REPORT_VISUALIZER 正交（后者管生成，此旋钮管注入正文）；默认开（VIZ-1）
# REPORT_PDF_EXPORT=true               # PDF-1：GET /api/report/{id}/pdf 惰性把 full_report.md 导出为 PDF（相对图表绝对化+可选 mmdc 预渲染 Mermaid，pandoc+xelatex，CJKmainfont=PingFang SC，--toc；失败回退 PyMuPDF），按成稿 mtime 缓存；默认开（PDF-1）
# REPORT_PDF_TIMEOUT=180               # PDF-1：单次 pandoc 构建超时秒数（超时即回退 PyMuPDF）（PDF-1）
# REPORT_EXEC_BRIEF=true               # DELIV-1：从每份完成报告惰性派生「一页高管简报 + 可分享速览」——GET /api/report/{id}/exec-brief（md）、/exec-brief.pdf、/digest 按源 mtime 缓存构建。纯确定性（NO LLM，只从成稿/forecast.json 抽取）：预测问题 + 3 句论点 + TOP 二元预测表（≤8 行：概率±集成离散/市场锚 Δ/判定日期）+ 关键情景概率 + scenario-bars 图 + 3 个带日期观察指标 + 一行诚实声明（pipeline_health/模拟运行健康，若可得）；双语（随成稿语言，另按 meta.translations[] 生成 exec_brief.<lang>.md）；PDF 复用 pandoc 引擎选择/PyMuPDF 回退但去 --toc 收紧边距做单页；默认开（关闭=三端点 404，degrade-safe）（DELIV-1）
# REPORT_FORECAST_LEDGER=true          # 把每份 forecast.json 追加进校准账本；已解析预测的历史 Brier/ECE 注入新预测 confidence_rationale（让信心被赚得）；默认开（NEXTSTEPS P2-4）
# FORECAST_LEDGER_DIR=                  # 校准账本目录（留空=PIPELINE_DATA_DIR/_forecast_ledger）
# FORECAST_LEDGER_COMMIT_MODE=published # EVAL-1: published (default) = commit the audit-sealed forecast.json only after the final publish audit passes (schema_version 2, idempotent, pre-registration keyed); legacy = pre-audit schema_version 1 append inside _finalize_structured_forecast; off = no ledger writes; unknown values act as published
# FORECAST_LEDGER_RECORD_UNPUBLISHED=true # EVAL-1: in published mode, a failed or unpublishable terminal report leaves one never-scored row_type=unpublished_terminal row with its reasons in the same ledger (auditable denominator)
# FORECAST_LEDGER_QUESTION_MAX_CHARS=4000 # EVAL-1: cap on question text stored per commit row; question_sha256 always covers the full normalized text
# FORECAST_LEDGER_SETTLEMENT_FOLD=false # EVAL-3: true = the report's historical calibration folds resolutions.jsonl settlement events and admits only items known before 00:00Z of the report's as-of date, adding as_of and a binary-scale block; false = report path byte-identical (the resolution monitor always shows the folded numbers)
# REPORT_RECALIBRATE_FROM_LEDGER=false # EVAL-3: shadow-only; recalibration_param reports it as `enabled` beside the fitted slope, but nothing applies a slope until a WP14 PromotionDecision
# RESOLUTION_MONITOR_RECENT_N=10        # MON-1 持续预测监测：scripts/resolution_monitor.py run --all-recent 缺省处理的最近报告条数（cron 驱动；重报价锚点市场+查询判定终态，落 price_track.jsonl / resolutions.jsonl / monitor_report.md；纯脚本旁路，不改在线管线）（MON-1）
# RESOLUTION_MONITOR_LOOKBACK_DAYS=0    # MON-1：0=不限；>0 时 --all-recent 仅监测 created_at 在近 N 天内的报告（更老的跳过）（MON-1）
# RESOLUTION_MONITOR_DRIFT_THRESHOLD=0.05 # MON-1：研究期价→现价 |Δ| ≥ 此值才计入 monitor_report 的「biggest movers」（过滤微抖动）（MON-1）
# RESOLUTION_MONITOR_AUTORUN_HOURS=0  # i8：>0 时后端进程内每 N 小时自动跑一轮 run --all-recent（子进程隔离、15min 硬超时、在飞去重；仅 run.py 生产入口启动）。0=关（默认，与历史行为一致——脚本此前从未有调度方）。手动触发：POST /api/research/resolution-monitor/run
# RESOLUTION_SETTLE_LEDGER=true        # EVAL-2: `resolution_monitor.py run --all-recent` also sweeps production primary commit rows of ledger.jsonl and appends idempotent schema_version 2 settlement events to resolutions.jsonl (`settle [--dry-run]` runs the sweep alone); inert unless the monitor runs
# RESOLUTION_MARKET_MIN_EQUIVALENCE=exact # EVAL-2: weakest market-anchor resolution_equivalence whose settlement can be scoring-eligible (exact|near|loose; loose acts as near because a loose or missing equivalence is always anchor_incomplete; unknown values act as exact)
# RESOLUTION_PENDING_GRACE_DAYS=180    # EVAL-2: days past a binary's resolution date before an unsettled item gets one never-scored terminal event (unresolvable_after_grace)
# RESOLUTION_SETTLE_MAX_TARGETS=200    # EVAL-2: newest production primary commit rows whose unrecorded market-anchored binaries one settle sweep fetches resolutions for (unanchored binaries past grace need no network and are never capped)
# RESEARCH_BUDGET_MAX_EPOCHS=3         # 研究预算 epoch 上限（resume/adaptive 追加研究时每纪元一份预算账本；超上限拒绝再开新纪元）
# REPORT_PROJECTED_EDGES=false         # 关系按价投影「到预测时点的轨迹」喂进报告信号包帮助情景分叉（contingent=支点）；模型先验非证据，默认关（NEXTSTEPS P3-8）
# SIM_SEED=0                            # OASIS 抽样/人设生成确定性种子（0=随机；集成/复现跑设同一正整数）（I-7-2）
# SIM_RESUME_REUSE_COMPLETED=true      # i5 resume 复用已完成模拟：三层 fail-closed 证据（完成旗标/actions 尾、run_summary、LOOP-011 封印权威 sha256 交叉核验）全过才复用；活进程/未封印目录一律重跑。false 恢复旧的一律重跑
# N_FORECAST_SEEDS=1                    # Foglamp WP1 (1D/I-12)：默认回到 1。当前额外种子共享同一 graph_id（伪集成：后种子可读到先种子的合成痕迹，spread 不是干净的不确定性）；WP10/12 交付快照+每种子隔离 overlay+独立 RNG 之前不得 >1（CONF-1→WP1；NEXTSTEPS P0-3）
# ENSEMBLE_SEED_CONCURRENCY=2           # PAR-3 多种子集成的并行度（默认 2、上限 3；每种子独立 sim_id→独立目录/DB/文件式 IPC/仅注入子进程 env，故线程安全；设 1=复现旧的严格串行）（PAR-3）
# —— 校准基石（R2-CAL；calibration keystones）——
# FORECAST_PROB_FLOOR=0.03             # floor every retained scenario before final renormalization; never publish 0%.（R2-CAL-4）
# FORECAST_PROB_STRICT_PARSE=true      # typed probability parsing: '30%' reads as 0.30; unreadable/range/bound/mixed-scale values become null + probability_status=needs_review (contract audit fails) instead of 0.0, a uniform split or a 0.98 clamp; well-formed numbers are byte-identical; false = legacy coercion（REPORT-1）
# REPORT_SPINE_SELFCONSISTENCY_K=1     # Foglamp WP1 (1D)：默认回到 1。同模型重抽样 spread 不是校准过的不确定性；只有测得的不稳定性证明成本合理时再加（WP15）（R2-CAL-1/R2-CAL-17→WP1）
# ENSEMBLE_EXTREMIZE_A=1.0             # Foglamp WP1 (1D)：默认恒等 1.0。extremize>1 是预测政策，必须过 WP14 outcome-blind 晋升门才可覆盖（R2-CAL-2→WP1）
# REPORT_SPINE_ANCHOR_WORLDSTATE=true  # pass WorldState.shares as a structured base_distribution into spine derivation; constrain scenario set + keep probs within a band of the modeled share unless justified. Active only when SIM_DECISION_CHANNEL on.（R2-CAL-3）

# ===== EXECPLAN2 第二波改进旋钮（检索/双层路由/可观测/新能力；全部默认安全，留空即保持当前行为）=====
# —— 双层模型路由 + 上下文预算（Phase 5）——
# LLM_TIERED_ROUTING=true              # route mechanical extraction/decomposition to LLM_FAST_MODEL; quality calls stay strong. Inert until a fast model is set (CLI providers degrade to single model = no-op).（GAP-1）
# LLM_FAST_MODEL=                      # set to a genuine non-reasoning fast model on the proxy; used by graph extraction + mechanical JSON calls when LLM_TIERED_ROUTING=true; empty falls back to LLM_MODEL_NAME (no speedup).（GAP-1）
# LLM_STRONG_MODEL=                    # strong 档模型名（留空=复用当前模型）（I-6-2）
# LLM_FAST_PROVIDER=                   # fast 档若指向不同 OpenAI 兼容提供方（需配齐下面两项，否则忽略）（I-6-2）
# LLM_FAST_BASE_URL=                   # fast 档 base_url（I-6-2）
# LLM_FAST_API_KEY=                    # fast 档 API Key（I-6-2）
# —— QUALITY-OPT S9：提供方故障转移（主提供方 429 配额耗尽 / 422 内容审查拒绝后，自动用回退提供方重试同一请求）——
# LLM_FALLBACK_PROVIDER=antigravity    # 推荐：Antigravity 经 Quotio；留空=关闭故障转移。主失败且配置后，本次调用透明改走回退（不递归）。
# LLM_FALLBACK_MODEL=                  # 回退模型（留空=回退提供方默认/Config）
# LLM_FALLBACK_BASE_URL=               # 回退 base_url（OpenAI 兼容时）
# LLM_FALLBACK_API_KEY=               # 回退 API Key
# LLM_FALLBACK_REASONING_EFFORT=       # 可选：OpenAI 兼容回退的推理档位（minimal/low/medium/high）；Quotio Antigravity 低延迟回退可设 low；其它值让后端启动报错退出（Config.validate，INFRA-6）
# DEERFLOW_FALLBACK_MODEL=antigravity  # 深研工具-free outline/section/judge：主模型有界重试后走 Antigravity/Quotio；留空=禁用
# DEERFLOW_FALLBACK_COOLDOWN_SECONDS=900 # 首次明确 429/配额/传输失败后，同一综合进程暂时跳过主模型，避免每个并行分节重复等待
# ADAPTIVE_CONTEXT=true                # RQ-7 已接线：按提供方窗口预算化前序章节[:8000]/人设[:3000]/世界简报切片；大窗口(MiniMax 512K/DeepSeek 1M)携带全量前文，小窗口守 floor。设 false 复现固定切片（I-6-4）
# DEFAULT_CONTEXT_WINDOW=32000         # 未知提供方的上下文窗口回退值（token）（I-6-4）
# RESERVED_COMPLETION_TOKENS=8192      # 截断时为补全预留的 token 安全余量（I-6-4）
# CONTEXT_ITEM_MAX_TOKENS=4096         # 单条上下文项的 token 上限（I-6-4）
# PERSONA_CONTEXT_FLOOR_CHARS=3000     # RQ-7：人设上下文切片 floor（字符）；ADAPTIVE_CONTEXT=true 且大窗口时以此为下限放宽（I-6-4）
# SIM_WORLD_BRIEF_MAX_CHARS=3000       # RQ-7：世界简报字符上限 ceiling；ADAPTIVE_CONTEXT=true 且大窗口把 1400 floor 抬到此值（I-6-4）
# —— 图谱检索 / 本体 / 人设（Phase 5）——
# GRAPH_SEARCH_RECIPE=rrf              # 默认检索 recipe：rrf | mmr | node_distance | cross_encoder | combined（I-1-0/I-1-6）
# ONTOLOGY_TEMPLATE=social_opinion     # 领域自适应本体模板：social_opinion | general_forecast …（I-1-3）
# ONTOLOGY_AUTO_SELECT=true            # route non-social forecasts to general_forecast instead of the 10-type social template; empty-result fallback re-runs default. 默认开（ONTO-4 / I-1-3）
# ONTOLOGY_RICH_SCHEMA=true            # 更丰富的本体抽取 prompt（实体分类/行为 DNA/valenced 关系）+保留完整 ontology 对象；默认开，新字段缺失时 no-op（与现状一致）
# CAST_RECONCILE=true                  # 抽取后跨轨去重 actors[]（合并同一实体的重复行+改写关系端点）；默认开，无重复 no-op（NEXTSTEPS P3-2）
# ONTOLOGY_FROM_DOSSIER=true           # 把已实现 actor 阵容（实体类型+关系类型）投影成「保留这些类型、至多再加2个领域专属类型、不要重命名」的本体种子模板，注入本体生成提示词（单一真源，防 schema/instance 漂移）；默认开，actor 阵容为空时 no-op（NEXTSTEPS P3-3）
# PERSONA_EGO_RETRIEVAL=false          # 人设上下文用「中心节点+类型化邻域」自我中心检索（I-1-5）
# PERSONA_BEHAVIORAL_DNA=true          # 人设提示注入 actor 行为 DNA（价值观/信念/激励/资源/风险偏好）+关系名册；默认开，新字段缺失时 no-op（与现状一致）
# PROFILE_ZEP_SKIP_WHEN_CONTEXT=true   # personas with non-empty bundled edges/nodes skip redundant Zep re-retrieval; cold entities still retrieve. 默认开（SIM-7）
# —— 研究契约 / 质量门（Phase 5；deerflow 子进程内经 env 读取）——
# RESEARCH_EVIDENCE_GRADING=true       # 抽取 source tier(S1-S4)/日期/Admiralty grade + 争议声明（I-0-0/I-0-1）; Config knob (unset/empty = true, else 1/true/yes/on), forwarded to every research child; also gates the report agent's contested-claims block and tiered source index (INFRA-14)
# RESEARCH_FORECAST_INPUTS=true        # 抽取 quantitative_facts（含单位+as-of 日期）→ quantitative.json（I-0-5）; Config single source (unset/empty = true, else 1/true/yes/on), forwarded to every research child; also gates the report agent's forecast-inputs block and is the master switch of RESEARCH_V3_FORECAST_INPUTS
# RESEARCH_QUALITY_GATE=false          # 研究后做覆盖/质量门（不足时告警/补一轮）（I-0-3）
# RESEARCH_QUALITY_FLOOR=0.45          # soft floor for the research_quality score; below this the run warns/penalizes confidence. RESEARCH_QUALITY_GATE stays off until validated on real runs.（R2-RES-1）
# —— 深度研究：源捕获 + 覆盖门（deerflow 子进程内读取；默认开）——
# RESEARCH_GROUND_SOURCES=true         # 用 ACTUALLY-FETCHED 的 web_fetch URL 接地 sources.json：丢弃无 URL/编造的模型来源，用模型的 tier/date 富化真实抓取页。修复 sources 全空 URL + 幻觉/未来日期来源。
# RESEARCH_COVERAGE_GATE=true          # KIQ 收敛门：只在研究笔记明确列出未决 KIQ gap 时跑定向补证；来源总数仅作遥测，绝不单独触发工作或质量降级。
# RESEARCH_MIN_SOURCES=20              # 旧仪表盘的来源数量比较线（仅 telemetry reference，不是下限/配额/发布门）；继续与否由 KIQ evidence delta 决定。
# RESEARCH_COVERAGE_GATE_MAX_ROUNDS=2 # standard 档定向 KIQ 补证的安全轮数上限；无 gap 或无证据增量即提前停止。
# —— 深度研究：自适应 pass + 通用分级 + 三角验证 top-up（SCALE-5；deerflow 子进程内读取；默认对 deep 开）——
# RESEARCH_ADAPTIVE_PASSES=true        # SCALE-5：只要上一轮笔记仍报出未决 KIQ gaps 且总 pass 数未触顶，就再跑定向收口；gap 消失、平台期或连续无 evidence delta 即收敛，不追逐来源总数。
# RESEARCH_MAX_ADAPTIVE_PASSES=7       # 深度研究总 pass 上限（6 个固定 pass + 最多 1 个真正有证据增量的自适应收口）；每个后续 pass 用隔离线程和压缩笔记，零来源增量即停，避免全历史重放长尾。
# RESEARCH_PRIOR_NOTES_CONTEXT_CHARS=60000 # 隔离 phase/adaptive 回合可见的压缩前序研究笔记上限；不把 LangGraph 全工具历史逐轮重放进模型。
# RESEARCH_BUDGET_DENIAL_BREAK_AT=3    # 连续收到 N 个 research_budget_exhausted 工具结果即结束当前流段并打捞已有笔记，避免额度耗尽后继续烧模型 token。
# RESEARCH_EVIDENCE_LANE_DELEGATION=false # 外层三条 evidence lane 已提供 breadth；默认禁止各 phase 再嵌套 task 子代理，避免 breadth 平面相乘。
# RESEARCH_EVIDENCE_LANE_REQUIRE_SOURCES=true # evidence-only lane 至少要有 1 条 wrapper 级成功抓取 receipt；零来源不得冒充完成证据包。
# DEERFLOW_ADAPTIVE_PASS_RECURSION_LIMIT=360  # 每个自适应 gap-closing pass 的步进预算（护栏）。
# RESEARCH_UNIVERSAL_TIERING=true      # SCALE-5：域名表命不中、模型也没给 tier 的「已抓取真实来源」给一个基线 tier（默认 S3），避免大量 untiered 把 source_tier_mix 拖低（untiered 计权 0.3 < S3 的 0.4）。仅对 fetched 生效。=false 回退旧的 untiered。
# RESEARCH_DEFAULT_SOURCE_TIER=S3      # 上一行的兜底基线 tier（只允许 S1/S2/S3；S4=reject-tier 不可作默认，非法值回退 S3）。
# Comma-separated domains rejected before fetch because they are known AI/SEO
# aggregators rather than original evidence. Set empty to disable the default
# list, or RESEARCH_ALLOW_LOW_QUALITY_SOURCES=true for an explicit override.
RESEARCH_SOURCE_DENY_DOMAINS=economicsummarizer.com,insights.triplegains.com
RESEARCH_ALLOW_LOW_QUALITY_SOURCES=false
# RESEARCH_TRIANGULATION_TOPUP=true    # SCALE-5：抽取阶段 triangulation audit 标出的 top-10 单源载重声明作为显式核验目标跑一次专门 pass（找独立佐证/反证）+ 重合成，改写回 research_report.md；仅对 deep 生效；degrade-safe。
# DEERFLOW_TRIANGULATION_RECURSION_LIMIT=360  # 三角验证 pass 的步进预算（护栏）。
# —— 报告增强（Phase 5）——
# REPORT_TELEMETRY=true                # 报告级 LLM 成本/耗时汇总写入 run_summary（受 LLM_TELEMETRY_ENABLED 总开关约束）（I-5-4）
# REPORT_SIGNAL_PACK=true              # pin deterministic sim aggregates (top actors, volumes, coalition sizes, P(outcome), scenario diff) into every section as a citable numeric floor. 默认开（REPORT-3 / I-3-2）
# REPORT_SIGNAL_PACK_HEALTH_GATE=true  # REPORT-5：信号包按 run_summary.json 的 simulation_health 门控（fail-closed）：hollow 去掉动作量/派系/情景差异块，errored 再去掉世界态块（图谱派生的投影纽带/因果骨架保留），并注明模拟无可用行为数据；truncated/llm_degraded/未识别值附审慎提示；记入 forecast.json quality.signal_pack_health（summary 不可读另记 summary_unreadable 并告警）；ok/无 summary 逐字节不变；false=旧行为
# REPORT_WORLDSTATE_HIDE_INVALID=true  # SIM-1：world_state_trajectory.json 顶层 validity 显式非 valid 时，报告世界态块只留警示+裁定原因（隐藏份额/航点）、跳过世界态图表（trajectory_not_valid）、fork 对比表返回 None；默认开（fail-closed），valid/无 validity 的旧轨迹逐字节不变；false=旧行为
# REPORT_COMPARISON_TABLE=true         # what-if 报告生成基线-情景对比表；RQ-4 默认 false→true，缺基线时 no-op（I-3-4）
# REPORT_CAUSAL_SPINE=true             # 信号包注入确定性「因果骨架」块（chokepoint 多跳因果邻域 + 最强 source→outcome 路径）；RQ-4 收编幽灵旋钮并默认开，无 actors/遍历失败时 no-op（R2-KG-7）
# REPORT_RELATIONAL_ROSTER=true        # 报告背景注入 actor 关系名册+激励结构（盟友/对手/竞争者/客户/供应商/出资方…）；默认开，新字段缺失时 no-op（与现状一致）
# —— 观测 / 复现 / 鲁棒（Phase 4-5）——
# SIM_EMERGENT_METRICS=false           # 把涌现结构/观点动力学指标写入 run_summary.json（I-2-0）
# IPC_TELEMETRY_ENABLED=true           # interview round-trip + profile-fallback telemetry so thin reports are diagnosable. 默认开（SIM-12/OBS-1 / I-5-5）
# RECORD_RUN_MANIFEST=true             # 写每次运行的复现清单 run.json（provider/model/depth/seed/git SHA）（I-8-1）
# STAGE_SCORECARD_ENABLED=true         # 管线终态写确定性分阶段记分卡 stage_scorecard.json（纯观测侧车，绝不改状态/健康；回填: scripts/stage_scorecard.py score）（EVAL-15）
# COST_CARD_ENABLED=true               # terminal pipelines write <pipeline_dir>/cost_card.json (drf-cost-card/v1: per-stage calls/tokens/wall, USD secondary, completeness reasons) and ledger commit rows carry the run's config_hash (pinned in options.config_hash_v1 at the report stage); attempt starts and wall-window openings are pinned in options.cost_card_attempt_v1 / cost_card_windows_v1; never the report folder; false = no card, no pins, no stamp; backfill: scripts/cost_card.py build <pipeline_id> (EVAL-18)
# RUN_SHAPE_PIN=true                   # 准入钉 options.run_shape_v1（结果旋钮+provider 出处）、resume 漂移记录、run.json 保留 attempts 与复用阶段原 provider 戳、遥测标注阶段复用；false=旧行为（INFRA-7）
# RUN_SHAPE_DRIFT_POLICY=record        # resume 时 identity 旋钮漂移：record=告警并记录后继续 | refuse=点名漂移旋钮失败本次 attempt；provider 仅漂移永不拒绝，未知值按 record（INFRA-7）
# RESUME_LINEAGE_GUARDS=true           # 上游阶段重算后拒绝复用陈旧下游产物（本体/图谱/PREPARE/报告），失效记录跨 attempt 持久化直到该阶段从当前上游重建（已保存的新本体/已完成的铸出报告下次复用），留 reuse_refused 面包屑；false=旧的逐阶段复用（INFRA-7）
# RECORD_MODEL_PROVENANCE=true         # per-stage requested vs served model (telemetry model_resolution, run.json requested_model/requested_source/requested_models/served_models/model_resolution, forecast.json model_provenance; also sets the research/simulation children); per-call labels and served ids need LLM_TELEMETRY_ENABLED=true, else a stage names its configured pair (requested_source=configured); research v3 resume refuses a work dir from a different resolved model id; false=byte-identical to before（INFRA-8）
# FORK_INHERIT_SAFETY_POLICY=true      # 情景分叉/批次问题分叉深拷贝 base 的 safety_policy_v1（origin=fork_inherited）；base 无钉时按分叉准入捕获（origin=fork_admission）；false=旧行为（分叉不带钉，读当前环境值）（INFRA-9）
# ACTOR_NAME_MATCH_STRICT=true         # actor name lookups fail closed on ambiguity: opinion_shift resolves its target via the research roster (exact name/alias, else a unique >=4-char containment) and lists the candidates instead of merging trajectories; trace_cascade node resolution checks roster aliases, needs >=4-char containment and a unique hit; actor_alias_map drops aliases claimed by two actors; unique <4-char containments (Fed -> Federal Reserve) no longer resolve unless the short name is an exact roster name/alias; false = legacy substring / 2-char / last-writer-wins matching (INFRA-11)
# PIPELINE_STRICT_SCHEMA=true          # 加载 pipeline_state 时做模式版本校验/迁移（I-4-4）
# PIPELINE_RUN_STALL_S=1800            # RUN 阶段停滞看门狗：模拟长时间无轮次推进视为卡死并终止（秒；<=0 关闭）（NEXTSTEPS 鲁棒性）
# —— 新能力（Phase 5；默认关）——
# API_V1_ENABLED=false                 # 挂载稳定版程序化 API /api/v1（鉴权复用 /api 闸门）（I-9-5）
# MODEL_COMPARISON_ENABLED=false       # 启用模型对比工具（同一预测多提供方）（I-9-4）
# —— 推理模型 / 报告（既有旋钮，此前未文档化）——
# LLM_DISABLE_THINKING=               # 通用：关闭推理模型的思考（避免 reasoning 吃光 max_tokens）
# REPORT_AGENT_MAX_REFLECTION_ROUNDS=  # 报告 agent 反思轮数上限

# ===== EXECPLAN2 第三波改进旋钮（剩余 L-effort 新能力；全部默认关，留空即保持当前行为）=====
# —— 深度研究扇出（I-0-4；deerflow 子进程内经 env 读取）——
# RESEARCH_DEEP_FANOUT=true            # legacy bridge KIQ/actor fan-out fallback. LOOP-009: when harness task delegation is active this plane is automatically suppressed, preventing duplicate breadth work; it remains active when subagents are off.
# RESEARCH_ALLOW_STACKED_FANOUT=false  # experimental only: true allows harness subagents + legacy bridge fan-out together. Default false because recent nested runs reached ~80M measured research tokens.
# RESEARCH_FANOUT_WIDTH=8              # 扇出宽度上限（并行子调查数），防止工具/LLM 预算放大失控（CONF-1 4→8 与扇出默认开配套；I-0-4）
# RESEARCH_TRIM_TOKENS_TO_SUMMARIZE=   # i7 杠杆2（默认空=不覆盖，today 行为逐字节保留）：正整数=lead-agent 摘要中间件的 trim 阈值（更小=各阶段从更紧的证据摘要起步，打断线程二次方增长）；none/null/full=强制全段。A/B 实验用，见 docs/RESEARCH_STAGE_OPTIMIZATION.md
# DEERFLOW_CLAUDE_PROMPT_CACHE=        # i7 杠杆1（默认空=开，config.yaml enable_prompt_caching）：Claude 研究 provider 的 prompt 前缀缓存（≤4 断点：system/tools 锚 + 最新 3 条消息）。0/false=硬关（载荷字节形状回到历史行为，回滚开关）；1/true=强制开
# RESEARCH_PARALLEL_TRACKS=3           # 编排器级多角度研究轨：>1 时排队 K 个研究子进程（轨1=原始brief/轨2=基率·参照类/轨3=激励·反面·市场），各写 handoff/track_<k>/ 后确定性合并；同时活动轨数受全局子代理信封约束，不能再以外轨数乘出额外并发。
# RESEARCH_GLOBAL_SYNTHESIS=true       # LOOP-010：多轨只并行产出 lossless evidence_pack.md；全部轨完成后用合并来源索引跑一次全局 outline→分节综合→judge→抽取/市场/图表。避免 3 份完整 10–20 节报告和 judge 的重复 token 成本；全局综合失败时从基线轨 checkpoint 恢复一次单轨综合。
# RESEARCH_GLOBAL_SUBAGENT_CAP=9        # LOOP-009：所有同时活动外轨合计的 harness 子代理信封；若小于轨数，外轨执行器自动降到该并发数（例如 3 轨/cap 2 = 同时 2 轨、每轨 1 子代理）。
# RESEARCH_GLOBAL_MODEL_CONCURRENCY=0   # 0=按外轨+子代理自动推导；正数=所有并发 pipeline 共用的 provider-call 信封
# RESEARCH_CONVERGENCE_SCHEDULER=true   # pass-0 已交完整 KIQ ledger 时跳过重复 scope；actor phase 仅在其 dossier 已实际注入 Track-A 时才可跳过
# RESEARCH_COMPACT_REPEAT_RESULTS=false # opt-in only：lane 不是严格 context 边界；默认保留每个独立 worker 的完整缓存证据，单飞仍去重网络请求
# RESEARCH_SUBAGENTS_PER_TRACK_MAX=5    # 单轨 harness 子代理上限（harness 范围 1..8）；单轨仍可用满 5，多轨按全局信封自动摊分。
# RESEARCH_GLOBAL_MODEL_CONCURRENCY=0   # provider-facing 总模型流信封（lead、双轨、并行 phase、裸模型分节和 harness 子代理全部计入）。0=自动推导为全局子代理 cap + 同时活动外轨数；正数显式覆盖。SQLite lease 跨进程强制执行并带心跳/崩溃过期回收。
# RESEARCH_MODEL_LEASE_DB=              # 空=backend/uploads/research_model_leases.sqlite3。必须是应用级稳定路径（不是单个 pipeline handoff），因此多个同时运行的预测也共享同一 provider 模型并发信封。
# RESEARCH_FANOUT_WORKER_BUDGET=260   # PAR-1 每个 fan-out scoped worker 的步进预算（原死值 220→默认 260）；非法/非正回退 260。并行深度阶段各自传 phase 预算，不读此默认
# RESEARCH_PARALLEL_PHASES=true        # PAR-1 deep 协议 phase 2-4（primary-evidence/actors/contradictions）并行跑（各自隔离线程+phase 预算），join 后吸收进主线程再顺序跑 forecast-implications；默认开，=false 走逐字节一致的顺序路径；worker 失败自动回退该 pass 顺序补跑
# RESEARCH_AGENTIC_SEARCH=true         # TRUE agentic search：仅当本轮以 --subagents（DEERFLOW_SUBAGENTS=true）启动、harness 内建 task 工具解锁时生效——向研究各回合提示词（开场/并行·顺序 phase/覆盖·收口·judge top-up）注入「委派 scoped-researcher 子代理」指令块，让 lead 把 breadth（逐 actor/逐 KIQ/语言·地域 pivot/反证）拆成 3–5 个并行子任务再校验并入；配套 config.yaml 的 subagents.custom_agents.scoped-researcher。默认开；=false 只关指令注入（不影响 --subagents 本身），研究提示词逐字节回退无委派路径。并发上限现由 subagents.max_concurrent（默认 5，clamp [1,8]）配置，env DEER_FLOW_MAX_CONCURRENT_SUBAGENTS 覆盖
# —— 研究检索后端 + 源缓存 + 数据分析执行面（deerflow_bridge：search_tools / cached_fetch / deerflow_research，经编排器 env 原样下发给桥子进程）——
# RESEARCH_BUDGET_ENABLED=true         # LOOP-007：跨进程 SQLite 控制面；所有外层研究轨/双轨/phase/subagent 共用全局预算，外层轨各有 lane 预算。失败 fail-open 并在 handoff/research_budget.json 标 degraded
# RESEARCH_BUDGET_ATTEMPTS_GLOBAL=1800 # search+fetch 工具总尝试数（含缓存命中/负缓存抑制）；阻止 agent 无网络也无限循环
# RESEARCH_BUDGET_SEARCH_GLOBAL=900    # 整个研究阶段允许的真实 web_search 网络调用数
# RESEARCH_BUDGET_SEARCH_LANE=360      # 单条外层研究轨允许的真实 web_search 网络调用数
# RESEARCH_BUDGET_FETCH_GLOBAL=450     # 整个研究阶段允许的真实 web_fetch 网络调用数
# RESEARCH_BUDGET_FETCH_LANE=180       # 单条外层研究轨允许的真实 web_fetch 网络调用数
# RESEARCH_NEGATIVE_CACHE_TTL_SECONDS=600 # exact 空搜索/死抓取的抑制窗口（默认 10 分钟）
# RESEARCH_NEGATIVE_CACHE_RETRIES=1    # 首次空结果后最多再放行 1 次 exact 重试；随后在 TTL 内稳定返回抑制结果
# RESEARCH_COMPACT_MERGED_DOSSIER=true # 多轨 raw actor_dossier 留在 track_N/；主 handoff 只写 canonical cast + 一跳关系，建图不再吃 K 份重复散文
# ACTOR_DOSSIER_MAX_CHARS=80000        # canonical actor dossier 入图前字符硬上限；失败回退单一最佳轨而非 K 轨拼接
# SERPER_API_KEY=                      # ITEM 6 web_search 后端调度：配了此 key → 用 Serper（Google 搜索 API，实时结果，https://serper.dev）。config.yaml 的 web_search=search_tools:web_search_tool 在调用时按此 key 择优选后端（Serper > Tavily > 社区 DDG），并把调用原样委派给 harness 自带对应 community 工具，行为与直接配置该 provider 逐字节一致。留空=不选 Serper
# TAVILY_API_KEY=                      # ITEM 6 web_search 后端调度：未配 SERPER_API_KEY 且配了此 key → 用 Tavily。两把 key 都留空（零 key）→ 回退社区 DuckDuckGo（无需 key），即 byte-equivalent 的 DDG 行为
# EXA_API_KEY=                         # web_fetch failover：Jina transport 超时/熔断后走 Exa get_contents；每个物理 provider 请求分别占用 fetch budget。
# FIRECRAWL_API_KEY=                   # Firecrawl（https://firecrawl.dev）：配了此 key → web_fetch 以 Firecrawl v2 /scrape 为**主抓**（托管渲染抓取，Jina 降为回退），web_search 在无 SERPER/TAVILY key 时以 v2 /search 为后端（取代社区 DDG）。留空=不启用
# RESEARCH_FIRECRAWL_FETCH_TIMEOUT_SECONDS=25   # 单次 Firecrawl scrape 墙钟上限
# RESEARCH_FIRECRAWL_SEARCH_TIMEOUT_SECONDS=20  # 单次 Firecrawl search 墙钟上限
# RESEARCH_FIRECRAWL_FETCH_MAX_CHARS=12000      # scrape 正文截断长度（与 Exa 同义旋钮）
# RESEARCH_FIRECRAWL_SEARCH_LIMIT=5             # 花费护栏：Firecrawl /search 按**结果条数**计费，实际上送 limit=min(调用方 max_results, 此上限)。下限 1，非法值回退 5
# RESEARCH_FIRECRAWL_MAX_AGE_SECONDS=172800     # 花费护栏：/scrape 载荷带 maxAge（本值为秒，上送时转毫秒）——窗口内未变页面由 Firecrawl 端缓存回放，不触发全新计费抓取。缺省 2 天；0=不带此字段（每次真抓）
# RESEARCH_FIRECRAWL_MAX_FETCH_CALLS_PER_PROCESS=400   # 花费护栏：单研究子进程 /scrape 计费调用硬上限；越线返回 "Error:" 哨兵并顺链回退 Jina/Exa（只 warn 一次）。<=0=不限
# RESEARCH_FIRECRAWL_MAX_SEARCH_CALLS_PER_PROCESS=300  # 花费护栏：单研究子进程 /search 计费调用硬上限；越线返回瞬态 {"error"} JSON（不负缓存，只 warn 一次）。<=0=不限
# RESEARCH_JINA_PRIMARY_TIMEOUT_SECONDS=10 # 单次 Jina 主抓墙钟上限；连续 transport failure 达阈值后共享熔断。
# RESEARCH_EXA_FETCH_TIMEOUT_SECONDS=15 # Exa failover 单次墙钟上限。
# RESEARCH_PROVIDER_FAILURE_THRESHOLD=5 # 同一 provider 连续 transport failure 达 N 次打开跨进程熔断。
# RESEARCH_PROVIDER_COOLDOWN_SECONDS=120 # provider 熔断冷却秒数；冷却后只放行一个 half-open probe。
# RESEARCH_PROVIDER_PROBE_LEASE_SECONDS=30 # half-open 探针租约，防并行 lane 在恢复瞬间形成惊群。
# RESEARCH_DIRECT_FETCH_FALLBACK=false # 原始 HTTP/readability 抓取只可显式开启；默认由 Jina→Exa 两级内容 provider 处理。
# RESEARCH_SOURCE_CACHE_DIR=           # ITEM 10 跨 run 源缓存目录（cached_fetch 透明包裹 jina web_fetch）。留空=<脚本目录>/.cache/source_cache（部署目录跨 run 稳定，故缓存天然持久）。键=sha256(url)，值={url,content,fetched_at,content_len}
# RESEARCH_SOURCE_CACHE_TTL_H=72       # ITEM 10 源缓存存活期（小时）：命中且未过期即秒回（返回类型与 jina 一致，对 agent 透明）。0=关闭缓存（透明直连 jina，与今日逐字节一致）。过期判定基于落盘 fetched_at（非 mtime；mtime 仅作 LRU 近用标记）。非法值回退 72
# RESEARCH_SOURCE_CACHE_MAX_MB=500     # ITEM 10 源缓存目录字节上限（MB）：超限按 mtime 升序 LRU 淘汰最久未用的 *.json 直到回落。<=0=不限。失败/哨兵("Error:"起头)/死抓取(<200字符)一律不落盘。非法值回退 500
# —— 图谱：派系检索 + 实体消解（I-1-2 / I-1-4）——
# GRAPH_COMMUNITY_RETRIEVAL=           # 把已发现社区做成可检索结构（faction_brief 工具+人设群体身份）；留空=跟随 GRAPH_BUILD_COMMUNITIES（I-1-2）
# GRAPH_RESOLVE_ENTITIES=true          # post-build embedding+name-match merge (NO LLM); dedup safety net for parallel build, truer centrality. 默认开（GRAPH-4/GRAPH-1；I-1-4）
# GRAPH_RESOLVE_SIM_THRESHOLD=0.88     # 合并所需最小 embedding 余弦相似度（规范名匹配+此阈值双重门）（I-1-4）
# GRAPH_RESOLVE_MAX_NODES=1200         # 实体消解 plan_merges 是 O(N²) 全配对扫描，节点数很大时是纯 Python CPU 墙（实测大图谱在此步 100% CPU 卡死）。超过此阈值改走 O(N) 精确同名/别名快路（仍合并精确重复，绝不卡死）；≤阈值走完整含包含匹配的路径。0=永远走完整路径
# GRAPH_COMPONENT_WARN_RATIO=0.2       # KG-8 分量数>节点数×ratio 时告警欠合并（由 0.5 调低；132 节点/30 分量的建图现在会告警）
# GRAPH_CHOKEPOINT_PRIORS=false        # R2-KG-5 结构咽喉先验（介数中心度+关节点），默认关；开启后落 handoff/graph_priors_structural.json
# GRAPH_CHOKEPOINT_MAX_NODES=1500      # O(V*E) 咽喉计算的节点上限，超限跳过（非法/非正值回退 1500）
# GRAPH_PRIORS_ALIAS_FOLD=true         # KG-7 中心度先验按 actors.json 策展别名组折叠（组内取 MAX，只升不降 ADD-only）
# GRAPH_MAX_SKIPPED_RATIO=0.3          # KG-5 建图跳块比例超此值时 GRAPH 阶段在 pipeline_health 标记 degraded
# GRAPH_CHUNK_MAX_ATTEMPTS=2          # i4 每 chunk 共享尝试预算（schema 重掷/回退趟/429 重放合计）；此前最坏 3-4 个完整抽取趟 ≈ 每失败槽 ~24 次 provider 调用。≤0 恢复旧行为（test-pinned）
# GRAPH_CAST_CHUNK_FILTER=true        # i4 建图 cast 相关性预过滤：actors.json 演员名/别名/关系端点零命中的 chunk 直接跳过 LLM 抽取（未播种/全滤→自动旁路；跳块记入 last_ingest_stats.skipped_cast_filter，告警分母只算实际送 LLM 的块）。false 恢复全量抽取
# GRAPH_QUERY_MAX_CHARS=0              # KG-2 图谱检索查询长度上限；0=自动（GRAPHITI_REMOTE=true 时 380，本地后端 1200），非零覆盖
# GRAPH_QUERY_CLAMP_SEMANTIC=true      # KG-2 超长查询截断时保留前缀+尾部专名/数字 token，而非盲切前缀
# SIM_TIER_FROM_ONTOLOGY=false         # ONT-7 实体类型级 archetype/simulation_tier 作为 agent 准入第三级信号（默认关）
# —— 模拟：情感动态 + 中断续跑（I-2-1 / I-4-2）——
# SIM_AGENT_DYNAMICS=true              # 逐智能体动态情感状态（情绪/精力/立场强度/疲劳）按轮注入提示（默认开；NEXTSTEPS P0-4 / I-2-1）
# SIM_SYNTH_SEED_POSTS=true          # 种子内容兜底：当事件配置 LLM 返回 0 条 initial_posts 时，
#                                      从研究档案合成种子帖（头部角色就热点议题陈述实证立场），
#                                      避免开局空 feed → agents 只能 FOLLOW → 0 有机帖（hollow 空转根因）。
#                                      窄触发（仅补空缺失态）+ degrade-safe（异常→空）。默认开。
# SIM_SYNTH_SEED_POSTS_MAX=10          # 合成的种子帖上限（按影响力/tier 取头部角色）。
# SIM_WORLD_BRIEF=true                 # 世界简报注入：把「预测问题+局势简报+热点话题」（≤1400 字）追加到
#                                        每个 agent 的 system prompt——agent 知道这个世界在争论什么。默认开。
# SIM_WORLD_BRIEF_HONEST_LABEL=true    # SIM-5 世界简报标题如实标注「研究综述，未逐条标注来源；背景参考，并非已核实事实」（不再称「权威背景」）。false → 旧标题
# SIM_EVENT_PROVENANCE=true            # SIM-5 定时事件/情景注入的来源标注：feed 帖带 [WORLD EVENT …]/[SCENARIO ASSUMPTION …] 前缀，动作统计/议程分层/派系图/立场轨迹/决策名册/回应阶段不再把注入内容记作发帖行为者的行为。false → 旧行为
# SIM_PERSONA_DESIGN=true              # 人格设计（实证语境工程）：对有档案的真实主体，在画像 LLM 调用中产出
#                                        结构化 persona_design（身份/观点信念/激励/目标/关系/红线/决策风格/话术），
#                                        严格接地研究档案、禁止发明立场；多样性来自真实主体的真实差异。默认开。
# SIM_MARKET_PRIORS=true               # 市场先验注入（ITEM 11）：把 handoff/prediction_markets.json 的市场隐含概率
#                                        灌进模拟——world_brief 追加「市场定价」块（top 5 相关市场 question+隐含 P），
#                                        并对分析师/媒体类人设加一行市场感知提示（关注话题与市场问题词重叠时）。
#                                        文件缺失/无对应 handoff → 与今日逐字节一致（degrade-safe）。默认开。
# ===== Polymarket 预测市场（官方公开 Gamma API，gamma-api.polymarket.com，无需 API key）=====
# PREDICTION_MARKETS_ENABLED=true      # 主开关：研究阶段拉取相关活跃市场，隐含概率作为校准锚注入
#                                        研究报告 + 报告章节 + 二元预测抽取（预测 vs 市场分歧 >10pt 须解释）。
#                                        数据源无需凭证；degrade-safe：网络失败 → 一行日志后跳过，主流程不受影响。
# PREDICTION_MARKETS_MAX=20            # 市场快照上限（按成交量降序取头部；旧名 ODDPOOL_MAX_MARKETS 仍读作兜底）。
# ODDPOOL_MAX_MARKETS=                 # 上一行的旧名兜底别名（仅 PREDICTION_MARKETS_MAX 未设时读取）；新配置请用新名。
# PREDICTION_MARKETS_MIN_VOLUME=200    # 成交量噪声下限（USDC）：低于此量的市场价格是噪声，剔除。
# PREDICTION_MARKETS_MAX_PER_EVENT=3   # 每个事件最多取几条市场（防一个多结局事件的子市场阶梯霸占名额）。<=0 不限制。
# PREDICTION_MARKETS_PER_QUERY=15      # 每个检索词最多取几个匹配事件（Gamma public-search 的 limit_per_type，8→15）。
# PREDICTION_MARKETS_MIN_RELEVANCE=5   # 相关性门槛（0~10）：LLM 批量打分低于此分的市场剔除，其余按 (relevance, volume)
#                                        重排；未打分/打分失败 → 保持 volume 排序（degrade-safe，与旧行为一致）。
# PREDICTION_MARKETS_REQUOTE=true       # PM-3 报告阶段对研究期落盘的市场快照做实时重报价（handoff-PLUS-refresh）：
#                                        保留研究期价 price_at_research + 当下价 + Δ（「34%→41%」），并在二元预测抽取前
#                                        再重报价一次使 market_anchor 用现价。关闭=只用研究期快照并在包头标注时效性。
#                                        重报价失败一律 degrade-safe（保留研究期价 + 时效性说明，绝不阻断报告）。
# PREDICTION_MARKETS_END_DATE_GATE=true # TIME-3: a market past its endDate never anchors a binary or seeds SIM priors; it stays in the market pack/research section labelled "window ended, awaiting settlement". false = pre-gate bytes.
# PREDICTION_MARKETS_END_DATE_GRACE_HOURS=0 # TIME-3: hours after endDate before a market counts as ended (clamped to 0-168; absorbs Gamma endDate quirks).
# PREDICTION_MARKETS_PRICE_HISTORY=true # PM-6 研究桥子进程：为通过相关性门的锚点市场抓 CLOB 历史价时间线
#                                        （keyless，https://clob.polymarket.com/prices-history?market=<clobTokenId>&interval=1d），
#                                        落 handoff/market_price_history.json {market_id:[{t,p}]}。degrade-to-empty：无 CLOB token/网络失败→跳过。
# PREDICTION_MARKETS_PRICE_HISTORY_MAX=20     # 抓历史价的市场数上限（成本护栏；镜像 backend 的 20/90d）。
# PREDICTION_MARKETS_PRICE_HISTORY_DAYS=90    # 历史价客户端裁剪窗口（天）。
# PREDICTION_MARKETS_PRICE_HISTORY_INTERVAL=1d  # CLOB prices-history 的 interval 档位（1h/6h/1d/1w/1m/max）。
# REPORT_THREE_PART_SKELETON=true      # B2 三部结构：Part 1 二元预测 / Part 2 框架综合（≤page_budget×150 词，
#                                        封顶 1800）/ Part 3 附录=原详细章节。无 Part 1 或综合过短 → 跳过。默认开。
# DEERFLOW_FETCH_RETRY=1               # R2 死链重试：Jina 抓取超时/死结果在丢弃前程序化重试 N 次（~8s 退避，
#                                        每轮至多 6 个 URL）。0=关闭。仅研究桥子进程读取（env 直传）。
# SIM_DYNAMICS_MOOD_LR=0.25            # 情绪更新学习率（有界 clamp；仅 SIM_AGENT_DYNAMICS=true 生效）（I-2-1）
# SIM_DYNAMICS_OPINION_LR=0.15         # 立场强度更新学习率（I-2-1）
# SIM_DYNAMICS_FATIGUE_RATE=0.20       # 每轮行动累积疲劳速率（I-2-1）
# SIM_DYNAMICS_FATIGUE_DECAY=0.10      # 每轮疲劳自然衰减（I-2-1）
# —— NEXTSTEPS P1-1/P1-4：决策通道 + 演化 WorldState + 收敛检测（建模"结果"而非"声量"）——
# SIM_DECISION_CHANNEL=true            # agents make a structured per-round outcome commitment evolving a base-rate-seeded WorldState; turns the sim from measuring voice to measuring outcome. Pairs with OASIS_DEFAULT_MAX_ROUNDS + convergence stop to bound cost. 默认开（R2-SIM-1/R2-CAL-3 / NEXTSTEPS P1-1）
# SIM_DECISION_EVENTS=true             # SIM-8: the decision-channel elicitor sees the period's scheduled events (incl., with SIM_PERIOD_CONTEXT_V2, events carried out of rounds no elicitation saw) as a labelled exogenous block before the roster (≤800 chars, whole lines), in-band and in the post-hoc calendar fallback; zero extra LLM calls; the post-hoc cache key gains an events digest only for rounds with events. false = prompts and cache keys byte-identical
# DECISION_CHANNEL_VALIDATION=true     # SIM-2: bind each decision-channel reply to the round roster (unknown ids/duplicates dropped, magnitude/confidence finite and clamped, missing magnitude rejected) and record reason counts + run-level fallback_share; zero extra LLM calls. false = legacy parse loop, byte-identical
# DECISION_CHANNEL_FALLBACK_MAX_SHARE=0.5  # SIM-2: above this share of roster slots with no accepted/abstained answer a would-be valid run becomes inconclusive (fallback_share_exceeded, no_update); uncalibrated; must be in [0,1] (NaN/out-of-range → 0.5 + warning)
# DECISION_CHANNEL_MAX_ACTIVE=60       # SIM-2 (defines the SIM-5 cap knob): per-round individual actors in the decision channel before the tail collapses into one public block (formerly an undefined ghost knob; same default)
# SIM_DECISION_INERTIA=0.7             # WorldState 先验每轮持久度 ∈[0,1]（高=稳、低=跳）
# SIM_CONVERGENCE_STOP=true            # EWMA early-stop on WorldState change after a warmup+window (EPS=0.02, WINDOW=3); convergence-at-R becomes a calibration signal. Requires the wiring landed in the sim bucket. 默认开（SIM-1 / NEXTSTEPS P1-4）
# SIM_CONVERGENCE_EPS=0.02             # 收敛阈值（EWMA(|Δoutcome|) 低于此判稳定）
# SIM_CONVERGENCE_WINDOW=3             # 连续稳定多少轮才判收敛
# SIM_RESUME_FROM_ROUND=false          # 模拟中断后从上次完成轮次续跑（依赖 OASIS DB 持久性）；默认关=全量重启（I-4-2）
# —— 预测质量评测（I-7-7；opt-in，绝不进默认 CI）——
# EVAL_ENABLED=false                   # 开启 eval_forecast_quality.py：LLM-judge 按 rubric 给固定情景集打分并与 baseline 对比（I-7-7）
# GOLDEN_EVAL_LEDGER=false             # 开启后 golden_eval.py 把已解析黄金题作为二元(YES/NO)预测写入校准账本，让 report_visualizer 校准曲线累积黄金题结局；默认关=只读打分，不污染生产账本（EVAL-1）
# GOLDEN_HEADLINE_GATE=true            # EVAL-8: golden_eval headline over prospective rows only (run, through its last recorded activity, before resolution and within the lead tolerance of as_of; never a pinned hindcast); other rows are characterization, an unbacked headline is withheld; false = pre-EVAL-8 reports
# GOLDEN_PROSPECTIVE_LEAD_TOLERANCE_DAYS=7  # EVAL-8: days after a golden question's as_of_date a run may still be active and count as prospective (0-3650; golden_eval fails loud on an unreadable value)
# EVAL_TARGET_REPAIR_DRAW=true         # EVAL-13: evaluation runs only (PipelineOrchestrator.start(evaluation=...) with a target): a pinned target statement missing from the binary forecasts gets exactly one bounded repair draw, kept only on a normalized match (never fabricated); inert for production runs

# ===== 运维脚本旋钮（此前各脚本 getattr 读但 config.py 未定义 = 幽灵旋钮；现已收口为真实可读项）=====
# SCHEDULER_ENABLED=false              # 定时重跑总开关（scheduled_rerun.py 的 daemon/tick；NEXTSTEPS P2-4 / I-9-6）
# SCHEDULER_TICK_SECONDS=300           # 调度器轮询间隔（秒）
# SCHEDULER_MAX_CONCURRENT=1           # 同时在飞的重跑上限
# DRIFT_PROB_THRESHOLD=0.15            # 漂移判定阈值：情景概率 |Δ| ≥ 此值即判材料性漂移
# DRIFT_WEBHOOK_URL=                   # 漂移回调 webhook（SSRF 校验后 POST；留空=不回调）
# BATCH_MAX_FANOUT=8                   # 多问题批跑单图谱最大分叉问题数（batch_runs.py 成本护栏；I-9-3）
# BATCH_SHARED_SIMULATION=false        # 批跑默认是否所有问题共用锚点模拟（仅重跑报告）
# BATCH_WAIT_TIMEOUT_S=14400           # batch_runs 阻塞等待锚点图谱/模拟的挂钟上限（秒），防永久空转

# ===== R2 审计修复旋钮（全部有安全默认；除标注外留空即保持修复后的默认行为）=====
# —— 管线编排（CFG-1 幽灵旋钮收编 + ORCH-*）——
# PIPELINE_HEARTBEAT_ENABLED=true      # I-4-1 owner 指纹+壁钟心跳看护（区分死管线与「慢但活」）；false 回退旧的 _threads 判定
# PIPELINE_HEARTBEAT_INTERVAL_S=30     # 心跳刷新节律（秒）
# PIPELINE_HEARTBEAT_STALE_S=120       # 心跳过期阈值（秒）：孤儿回收/就地 resume 回收的判死窗口
# PIPELINE_STALE_S=300                 # 状态 API 的 staleness 判定：超此秒数无进度显示「仍在思考」
# PIPELINE_ETA_CAP_S=7200              # ETA 线性外推的上限（秒），防早期外推出离谱数字
# PIPELINE_LIVE_ARTIFACTS=true         # I-4-6 运行中登记 *_partial 临时产物深链（增量证据）
# PIPELINE_PARTIAL_SCAN_EVERY_S=10     # 临时产物磁盘扫描节流（秒/阶段）
# PIPELINE_VALIDATE_ARTIFACTS=true     # I-4-3 复用前按 manifest（sha256/字节/schema 探针）校验阶段产物
# PIPELINE_VIZ_ARTIFACTS=true          # VIZ-2 把 handoff/charts/*.png|svg(+charts.json) 与 handoff/data/*.csv 纳入产物 specs（缺文件即 no-op）
# MANIFEST_CAPTURE_VERSIONS=false      # run.json 是否附带关键包版本（枚举有开销，默认关）
# PARALLEL_PROFILE_COUNT=16            # persona 并行扇出（HTTP 提供方；CLI 固定 3）（SIM-11）
# EMBED_WARM_AT_RESEARCH=false         # 研究阶段后台预热嵌入器 + 预嵌 actor 名/别名（R2-EXEC-7）
# VALIDATE_AS_OF_DATE=true             # R2-RES-7 研究 as_of_date 双时态锚校验（未来/早于证据/不可解析时回退）
# GRAPH_CHUNK_SOURCE=dossier_only      # 建图输入源：both | dossier_only | report_only；W9 默认 both→dossier_only（报告叙事块混入建图放大实体噪声）（RESEARCH-2/ONTO-7/W9）
# PIPELINE_RECLAIM_PORT_PROBE=true     # ORCH-2 启动回收前探测端口：已有后端在服务则跳过孤儿回收（防重复进程踩死活管线）
# SIMULATION_RECLAIM_PORT_PROBE=true   # 同构保护 OASIS 模拟：重复后端/误构造 app 不得终止现有后端拥有的活模拟
# REPORT_LLM_PREFLIGHT=true            # ORCH-8 报告阶段起飞前 ~10 token 探测主/回退提供方；双双不可用时 <60s 快失败（REPORT 阶段可 resume）
# —— LLM 客户端（LLM-*/XRUN-3；llm_client.py 直读 env 的熔断旋钮也在此文档化）——
# LLM_CLI_ISOLATE_HOOKS=true           # XRUN-3 claude CLI 子进程用 --settings 关闭全局 ~/.claude hooks（SessionEnd 钩子曾致 2769+ 次空错误失败）；保留 OAuth 登录
# LLM_CB_422_THRESHOLD=5               # 连续内容审查(422)达此次数触发熔断（env 直读）
# LLM_CB_COOLDOWN_S=300                # 422 熔断冷却秒数：期间跳过主提供方直连回退（env 直读）
# LLM_CB_429_THRESHOLD=8               # LLM-3 连续配额/限流(429)达此次数触发熔断（env 直读；配额耗尽时省掉每调用 ≥6s 的退避浪费）
# LLM_CB_429_COOLDOWN_S=120            # 429 熔断冷却秒数（env 直读）
# LLM_NATIVE_TOOLS_PROVIDERS=          # LLM-6 原生工具白名单覆盖（逗号分隔，如 openai,deepseek）；留空=按 PROVIDER_META 能力位（MiniMax-M3 默认禁用原生工具，走 ReAct）
# —— 深度研究（RES-*；bridge 运行在 DeerFlow venv、直读 os.environ——必须以环境变量下发）——
# ACTOR_SYNTH_MIN_CONTEXT_CHARS=3000   # RES-1 两条免工具合成网（Track A 报告/Track B 卷宗）要求的最少已收集上下文字符数；不足即拒绝编造、降级退出。0 关闭
# RESEARCH_MIN_REPORT_CHARS=400        # RES-1/RES-8 research_report.md 最短长度（不足=exit 2 无报告）+ 卷宗降级产物门；0 关闭长度门（错误串哨兵检查保留）。编排器侧镜像守卫同用此值
# RESEARCH_FETCH_ACCOUNTING_V2=true    # RES-2 按轮配对 tool_call_id 的抓取 URL 记账（锁定合并 + 严格 ok=True 去重计数）；false 逐字节回退旧的全局 LIFO 收集器。注意：诚实计数可能让覆盖门中途多触发补充 pass（预期行为）
# RESEARCH_ASOF_MAX_LAG_DAYS=45        # RES-3 模型抽取的 as_of_date 容忍窗口：早于 运行日−N天 视为幻觉训练截止日，改用运行日作定量核查/陈旧度基准（meta.as_of_date_overridden 留痕）
# RESEARCH_QUALITY_GROUNDING=true      # RES-4 research_quality 增加来源真实性 grounding（真实 fetch 数/档案声称来源数，非绝对来源下限，权重 0.25）+ 封顶 0.15 的定量不合理罚分；false 回退旧 3 分量口径
# ACTOR_DOSSIER_JUDGE_STRICT=false     # RES-9 opt-in 更严的卷宗 judge 门（每一维都 >=4，旧 SKILL §8.2 措辞）；默认维持抗噪声版（无维度 <3 + 4 关键维 >=4 + 均值 >=4）
# RESEARCH_COVERAGE_GATE_STANDARD=false # RES-11 opt-in 让 standard 深度也走覆盖门（补充 pass+重合成）；默认关保持成本。注：RESEARCH_COVERAGE_GATE 本身仅 deep 档生效
# RESEARCH_MULTIPART_SYNTHESIS=        # SCALE-1 多段合成（大纲 JSON → 并行分节裸调用（关键词分片上下文）→ 确定性缝合+执行摘要 → 散文词数长度门）；留空=仅 deep 开、quick/standard 走单调用现状；显式 true/false 对所有深度强制。deep 结构性/预算失败会保留证据并失败关闭，绝不把 pass notes 冒充报告
# RESEARCH_SYNTHESIS_WORKERS=4         # SCALE-1 逐节合成的并发工作线程上限（镜像 RESEARCH_FANOUT_WIDTH；非法值回退 4）
# SYNTHESIS_SECTION_CONTEXT_CHARS=60000 # 每节只路由正相关证据的字符上限（不是报告输出上限）
# SYNTHESIS_TOTAL_ROUTED_CONTEXT_CHARS=600000 # 所有分节合计证据重放上限，阻止整份 corpus × N 节
# SYNTHESIS_SECTION_MAX_BLOCKS=18       # 每节最多证据块；零相关块不为填满上下文而注入
# SYNTHESIS_OUTLINE_CONTEXT_CHARS=120000 # 大纲规划只需代表性证据切片
# SYNTHESIS_CONTEXT_WINDOW_TOKENS=      # 可覆盖模型 profile 的 context_window_tokens
# SYNTHESIS_OUTPUT_RESERVE_TOKENS=      # 可覆盖模型 profile 的 max_tokens；输入预算会先为输出留位
# RESEARCH_SYNTHESIS_MIN_WORDS=        # SCALE-1 长度门的最少散文词数（剔除表格行/URL/代码围栏后计词）；不足则定向再扩写 2 个最薄分节。留空=deep 15000 / 其余 4500；0 关闭长度门
# RESEARCH_SYNTHESIS_MAX_WORDS=        # 最终档案散文词数硬上限；留空=deep 22000 / 其余 7000。执行摘要先预留空间，超限失败关闭而非截断
# RESEARCH_SYNTHESIS_EXECUTION_MAX_OUTPUT_TOKENS= # 大纲、全部分节、截断重试、扩写、摘要共享的单一输出 token 账本；留空按最终词数上限×1.6 推导
# RESEARCH_EXTRACTION_MAX_TOKENS=48000 # 结构化抽取主调用的本地输出上限；不再继承模型 profile 的超大通用上限
# RESEARCH_EXTRACTION_RECOVERY_MAX_TOKENS=24000 # 主抽取不可解析时，紧凑无工具恢复调用的输出上限
# 旧 RESEARCH_EXTRACT_AGENT_FALLBACK 已移除：流式 agent 无法证明输出完整，主抽取+一次紧凑无工具恢复失败后必须拒绝发布 actors.json
# EXTRACTION_REPORT_EXCERPT_CHARS=0    # 0=完整报告；正数=抽取输入字符上限（速度模式，可能降低覆盖）
# —— 研究断点续跑 / 只抽取打捞（ITEM-3 / ITEM-14；bridge 直读 os.environ）——
# RESEARCH_CHECKPOINT=true             # ITEM-3 每完成一个研究 pass/phase 就把 research_checkpoint.json 原子落到 handoff_dir（thread_id + 已完成 pass-id + gaps + 抓取数 + question_hash）。编排器在崩溃/超时重试时若 checkpoint 存在即给子进程加 --resume：复用同一 LangGraph 线程、跳过已完成 pass、从下一 pass 续跑（question_hash/depth 不匹配→全量重启并打标）。false 关闭断点记录（所有记录 no-op，逐字节回退旧行为）
# RESEARCH_EXTRACT_ONLY_MIN_CHARS=400  # ITEM-14 --extract-only 前置门：既存 research_report.md 的最短字符数；不足=诚实非零退出（无可抽取的报告）
# RESEARCH_EXTRACT_ONLY_SALVAGE=true   # ITEM-14 编排器 watchdog 超时打捞：报告已落盘但缺结构化档案（'无结构化档案'）时，spawn 一个有界 --extract-only 子进程补出 actors/sources/timeline/quantitative 再降级继续；false 维持旧的空档案降级
# RESEARCH_EXTRACT_ONLY_TIMEOUT=600    # ITEM-14 打捞子进程的墙钟上限（秒，默认 10 分钟）；超时=best-effort 放弃、保留已有报告降级继续
# —— 本体/模拟准备（ONT-1/PREP-*/XRUN-10）——
# ONTOLOGY_SEED_ADAPTIVE_BUDGET=true   # ONT-1 本体种子块的新类型预算随种子规模自适应（max(2, 8-种子类型数)，总量 ≤10）；false 恢复固定「至多再新增 2 个」
# SIM_EVENT_REACT_BUFFER=true          # PREP-5 key_events 映射到 [0, 总轮数-max(2, 总轮数//5)]，末尾留反应窗（高潮事件不再落在最后一轮）；false 恢复全区间映射
# SIM_SCHEDULE_CLAMP_ROUNDS=true       # PREP-1 未显式传 max_rounds 时，事件排程钳制到 OASIS_DEFAULT_MAX_ROUNDS（时间线爆点不再排到执行窗之外）；false 恢复按完整配置轮数映射
# SIM_RULE_FALLBACK_STANCE=true        # PREP-2 规则回退/LLM 中立路径按卷宗 actor 立场播种 ±0.3 情感；false 恢复全中立回退
# SIM_SEED_POST_VARIANTS=true          # PREP-11 合成种子帖交替「立场宣示/争议提问」模板并按活动预设本地化；false 恢复单一英文模板
# PERSONA_FIELD_EXTRACTION=true        # XRUN-10 人设提示要求从卷宗提取 mbti/age/gender/country、不可推断则省略（中性国别措辞）；false 恢复旧提示
# —— 模拟运行环（RUN-*/XRUN-*；run_parallel_simulation.py env 优先、Config 兜底）——
# SIM_START_HOUR=0                     # RUN-4 模拟时钟起始小时（0-23；time_config.start_hour 优先）。默认 0=午夜与现状一致；生产建议设 9（最早共同活跃时段），避免轮次预算烧在结构性死轮上
# SIM_RECENCY_CARRY=false              # RUN-4 true 时零激活的死轮不再清空 last_active_ids，让 T3.5 recency 级联跨时段累积。默认 false=现状；生产建议 true
# SIM_TWITTER_MODEL_FREE_FEED=true     # RUN-6/S8 默认 Twitter 平台用免模型 'reddit' recsys（其余参数同 TWITTER 档），无需下载 twhin-bert；false 恢复 twhin-bert 默认。SIM_TWITTER_RECSYS 显式设置时优先
# SIM_TOOL_ARG_NORMALIZE=true          # XRUN-14 规范化幻觉工具参数（post_id→comment_id 别名、丢弃未知键并留痕），MiniMax-M3 参数幻觉降级为可执行动作而非吞掉异常；false 恢复原样透传
# SIM_IDLE_CLOSE_MIN=60                # XRUN-14 等命令模式空闲 N 分钟（无 IPC 命令）后自动关闭环境（防 15h 孤儿环境占库）；<=0 恢复无限等待。任何访谈/批处理命令重置计时
# SIM_LLM_ERROR_RATE_THRESHOLD=0.5     # RUN-2 llm_errors/llm_calls 超此比例的平台在 llm_health.json 标记 degraded=true（write_run_summary 据此降级 simulation_health）
# SIM_RESUME=false                     # RUN-7 逐轮 checkpoint.json + 非 COMPLETED 并行重跑自动续跑（env 优先，Config 兜底）
# SIM_CHECKPOINT=true                  # ITEM 3 每轮落 <platform>/checkpoint.json（含 config_hash+RNG 状态），使崩溃/重启后可续跑；置 false 关闭产出（SIM_RESUME=true 仍隐式开启写入）
# INTERVIEW_TIMEOUT_PER_AGENT=30       # RUN-12 批量访谈 IPC 超时按排队 agent 数缩放（timeout=max(传入, 60+per_agent*ceil(n/并发)）；<=0 关闭缩放
# SIM_CLI_TOOL_EMULATION=true          # XRUN-2 CLI 桥/文本回退路径上模拟 OpenAI function calling（提示词 JSON 工具块解析回 tool_calls）；false 恢复旧的忽略 tools 行为（agent 无动作）
# SIM_LLM_FALLBACK=true                # RUN-18 minimax/kimi/openai 直连 OASIS 模型路径的 422/429 失败经 LLMClient 改道（重试+熔断+LLM_FALLBACK_PROVIDER 回退）；false 恢复裸错误
# SIM_MIN_FREE_DISK_GB=2               # XRUN-4 模拟目录最低可用磁盘（GB）：起跑时检查（exit 1）+ 每轮前检查（平台硬失败）；<=0 关闭
# SIM_STEP_FAILURE_LIMIT=3             # XRUN-4 同一异常类连续 N 次 env.step 失败即硬失败该平台（系统性死亡熔断）；0 恢复旧的无限跳轮
# —— 模拟真实感（ITEM 20：采样/节流/比例侦测/小时记账，均 env 门控、默认安全、可降级）——
# SIM_ENGAGEMENT_SAMPLER=auto          # ITEM20(1) 每轮有机动作后从活跃 agent 确定性采样 LIKE_POST 落到本轮新帖（权重∝该帖本轮已获互动）；采样赞标记 is_engagement_sample 供比例侦测器排除。auto（默认）= 仅在 SIM_REACTION_PHASE=false 时开启（随机采样的「背书」与角色不符）；true/false 强制
# SIM_REACTION_PHASE=true              # SIM-REACT 每轮发帖后的回应阶段：活跃 agent 用帖子下的评论（及按身份的点赞）回应按角色相关性挑选的他人帖子（本轮+上轮，含对自己帖子的回复）；要求针对主帖、补充新信息、符合身份。false 关闭
# SIM_REACTION_SHARE=1.0               # SIM-REACT 每轮参与回应的活跃 agent 比例（clamp 到 [0,1]）；每个回应者多一次模型调用
# SIM_OUTPUT_LANGUAGE=                 # 模拟发帖/回应语言覆盖（English/Chinese）；空 = 配置的 output_language，缺省按预测问题的语言判定
# SIM_ENGAGEMENT_RATE=0.3              # ITEM20(1) 每个活跃 agent 本轮产生一次采样点赞的概率（clamp 到 [0,1]）
# SIM_MAX_FOLLOWS_PER_AGENT_ROUND=3    # ITEM20(3) 每个 follower 的种子 FOLLOW 动作上限（add_edge 建图不受影响，仅截断 FOLLOW 动作），避免种子关注风暴淹没早期动作日志；<=0 = 不限（旧行为）
# SIM_ORGANIC_RATIO_DETECTOR=true      # ITEM20(2) 逐平台逐轮 post:comment:like 塌缩侦测：连续 ≥K 轮 posts>0 而 comments+likes==0 时把结构化告警写入 run_summary（检测+诚实，绝不伪造互动）。false 关闭
# SIM_ORGANIC_RATIO_MIN_CONSECUTIVE=3  # ITEM20(2) 触发塌缩告警所需的连续塌缩轮数 K（<1 视作 1）
# SIM_ORGANIC_EXCLUDES_ENGAGEMENT_SAMPLES=true  # SIM-3 采样赞（is_engagement_sample）不计入 run_summary 有机动作数，只有采样赞+定时事件的运行如实判 hollow；排除数写 engagement_sample_count。false 恢复旧计数
# SIM_SCHEDULE_AUDIT=true              # SIM-3 定时事件可达性审计：round 非法/≥total_rounds、缺发帖者/内容的事件永不触发 → run_summary 写 schedule_audit，运行健康记 degraded issue（仅不可达数>0 时）。false 关闭
# —— 报告/预测（RPT-*/XRUN-1/XRUN-5/RPT-6）——
# REPORT_ABORT_ON_LLM_OUTAGE=true      # RPT-2 系统性 LLM 中断（大纲降级+前 2 章全失败）快速中止，全占位报告标 FAILED（可重试）而非 COMPLETED；false 恢复旧的硬撑到底
# LLM_OUTAGE_HALT_CONSECUTIVE=10      # i4 run 级断供闸：连续 N 次 provider 级失败（配额/确定性鉴权类）后整条管线快速落入既有 failed→resume 检查点态（不再 26h 空磨）；成功清零；内容过滤/解析/预算/取消不计数。0=关
# REPORT_PURITY_ESCALATION_MAX=12      # i2 语言纯度修复的强档调用上限（≤0 关闭升级）；连续 3 次调用异常短路。断供最坏情形 180→3 次强档调用
# REPORT_VIZ_PLOTLYJS_INLINE=false     # i1 回退旋钮：true 恢复逐图内联 plotly.min.js（每图 ~4.86MB）；默认 directory 模式 + 服务时内联（每图 ~8.4KB）
# REPORT_SECTION_RETRY_MAX=2           # RPT-2 每章写失败占位符前的重试次数；RQ-1 1→2；0=旧的无重试
# REPORT_SECTION_RETRY_BACKOFF_S=8.0   # RPT-2 章节重试基础退避秒数（按次线性，封顶 60s）
# REPORT_CRITIQUE_BEFORE_PROSE=true    # RPT-3 自校准/premortem 移到写散文**之前**，钉定骨架==交付 forecast.json（仅 REPORT_FORECAST_SELF_CRITIQUE 开启时生效）
# REPORT_CRITIQUE_SINGLE_PASS=true     # INFRA-2 红队评审每份报告至多一次：叙事前评审失败/回退后，成稿后不再二次评审，记 quality.critique_pre_prose=reverted_or_failed；false=旧的失败后成稿再评一次
# FORECAST_BINARY_CONTRARIAN=true      # RPT-4 二元预测提示词加入逆向框架规则 + stdev<0.12 或全部 p>0.5 时一轮有界(0.05-0.35)低概率重构
# FORECAST_BINARY_SYMMETRIC_GUARD=false  # REPORT-11 二元预测对称护栏：每条二元抽取提示词在逆向框架/低概率重述规则之后（逆向关时在基础 RULES 之后）追加 SYMMETRY GUARD（证据不支持所给概率就丢掉候选，不为凑区间挪数字、不制造极端）；会移动概率的提示词政策，须经 WP14 结果盲晋升门；开启时记入 forecast.quality.forecast_policy 与准入钉 safety_policy_v1；默认关（提示词逐字节不变）
# FORECAST_PROBABILITY_SHAPE=true      # REPORT-11 概率形状遥测：forecast.quality.probability_shape（情景峰值/归一化熵/距均匀 TV + 批判前后差值；二元中间带/近半/极端占比、十分位直方图、向/远离 0.5 的移动计数）+ 发布提交账本行 objective_signals；纯观测，任何门都不读；false=forecast.json 与账本行回到旧形态
# FORECAST_SIM_SENSITIVITY=true        # XRUN-1(b) 二元预测抽取注入模拟定量信号包，每条概率须说明相对 base_rate_anchor 的移动及具名模拟信号来源
# FORECAST_BINARY_THEMES=              # RPT-6 二元预测主题清单（逗号分隔，如 mercantilism,ai,intersection）；留空=经 requirement_spec 从 brief 派生，否则主题自由
# FORECAST_HORIZON_CHECK=true          # RQ-6 抽取时校验二元预测结算年份与 brief 目标年份是否重叠；完全不相交时在 forecast['quality'].horizon_mismatch 记标记供发布门降信心（任一侧解析不出年份则不加标记）
# FORECAST_ENSEMBLE_MODELS=            # ITEM 12 多模型二元预测集成：逗号分隔的（副）提供方名（如 openai,deepseek,glm）；空=关闭（默认，逐字节复现旧单模型行为）。开启时对每个所列提供方各跑一次同提示词二元抽取，按 id/陈述匹配同一条预测，用与种子集成同一套 extremizing log-odds（ENSEMBLE_EXTREMIZE_A）池化为发布概率并记 binary['ensemble']={models,probs,pooled,spread}；任一副提供方失败仅跳过并记 flag，绝不阻断
# FORECAST_ENSEMBLE_SPREAD_THRESHOLD=0.15  # ITEM 12 跨模型概率样本 stdev 超此阈值 → 该预测记入 low-agreement（binary_quality.ensemble.low_agreement），二元预测表以 ±spread 显示分歧；默认 0.15
# BACKBONE_CHECK_ENABLED=false         # EVAL-11 骨架跨底座敏感性影子检查（准入时钉进 safety_policy_v1.backbone_check，resume 不重新捕获）：主报告多抽 2 次骨架（同底座对照 + 副底座），把跨底座/同底座差异与 status 记入 forecast.quality.backbone_sensitivity；不改概率/区间/渲染/发布门；对照/副底座调用与主报告共用该提供方进程级 422/429 熔断状态，故主提供方熔断已有连续失败或冷却时不发调用（记 unchecked:primary_throttled）、跳过同样状态的副候选；默认关（无额外调用，产物逐字节不变）
# BACKBONE_CHECK_PROVIDERS=            # EVAL-11 副底座候选（逗号分隔提供方名，取第一个可构造且 (provider, model) 不同于主底座者）；空=无副底座（开启时记 unchecked:no_distinct_secondary）
# BACKBONE_CHECK_MAX_ABS_DELTA=0.15    # EVAL-11 越界阈值：任一情景 |Δp| ≥ 此值或领先情景不一致即越界；跨底座越界而同底座不越界 → backbone_sensitive，同底座越界 → unstable_within_backbone
# NUMERIC_GUARD_MODE=shadow            # TIME-5 已发布二元阈值数值一致性影子检查（off|shadow；准入时钉进 safety_policy_v1.numeric_guard_mode）：shadow 时二元提示词多索取可选 latest_actual（每条约 50 输出 token，无额外调用，max_tokens 按条数放宽），确定性检查 scale_mismatch / status_quo_contradiction / inverted_interval 只写 binary['numeric_guard'] 与 forecast.quality.numeric_guards，检查本身不改概率/正文/发布门/终审，但追加的提示词规则会改变起草（二元与概率可能与 off 不同）；off=提示词与 forecast.json 逐字节回到旧行为；非法值按 shadow 运行并告警；enforce 不实现
# NUMERIC_GUARD_SCALE_RATIO=300        # TIME-5 阈值/最新实际值中点之比 ≥ 此值（或 ≤ 其倒数，单位类与币种相同）→ scale_mismatch（误解析级）；须 > 1
# NUMERIC_GUARD_STATUS_QUO_MARGIN=0.25 # TIME-5 现状判定边际 m：最新实际值越过阈值 K 至少 m·|K| 才算已满足/已违背，概率在 0.5 另一侧且无 [S<n>] 引证 → status_quo_contradiction；须在 [0,1)
# REPORT_QUOTE_AUDIT_V2=true           # RPT-5 引语溯源审计 v2（系统 blockquote 豁免、归一化+3 探针、未逐字 vs 编造分流）；false 恢复单探针旧审计
# REPORT_COMPACT_RETRIEVAL_QUERY=true  # XRUN-5/RPT-8 每份报告派生一次紧凑检索查询（核心问题句+高显著度 actor 名）用于 requirement 域图谱检索，取代 3388 字符原始 brief
# REPORT_REPAIR_PASSES=true            # RQ-2 质量门失败时按维度单次定向修复（引用回填 against sources / 引文接地删除未证实 blockquote / 占位符 [S?] 解析或删除），重跑受影响审计一次并把 before/after 记进 forecast['quality'].repair（合并不覆盖）；任一步失败仅告警
# REPORT_LANGUAGE_PURITY=true          # RQ-2 成稿语言纯度扫描：非 CJK 目标里的 CJK 片段（反之亦然）一次批量 chat_json 内联翻译，引用型原文保留为括注；无片段/任何错误 degrade-safe 跳过
# REPORT_SECTION_REFLECTION=true       # RQ-5 每章草稿通过基本有效性后做一次廉价批判（骨架概率一致性/硬数字接地/篇幅下限/不复述前序章节），返回 PASS 或单条修订指令，至多一次修订抽取（上限 REPORT_AGENT_MAX_REFLECTION_ROUNDS/类常量 MAX_REFLECTION_ROUNDS；<=0 关闭）
# REPORT_NARRATIVE_SYNC=true           # REPORT-2 红队批判/事前验尸/K>1 池化移动概率后，按「移动前→移动后」唯一值映射把 headline/confidence_rationale/情景 summary 里的旧概率数字改成最终值（歧义/无法配对/区间/数量/合计语境跳过并计数，无法归属的值跨步骤保持阻断；原文存 *_detail，编辑记 forecast.quality.narrative_sync）；零 token，只改叙事文本；false 逐字节复现旧 forecast.json
# REPORT_ABSENCE_MARKERS=true          # REPORT-4 报告阶段提示词的类型化缺失标记（not_run/empty/unavailable）：章节质检无骨架时去掉概率一致性规则、缺失信号包/市场表写成类型化标记而非「（无）」、并行大纲意图不冒充前序章节；骨架首句只列实际注入的输入并在无研究基率时要求写明基率出处；diagnostic_only 下二元 source 行不再邀请具名模拟信号；章节前缀追加市场缺失说明；forecast.quality.prompt_slot_states 记市场槽状态；false 逐字节复现旧提示词
# —— BILINGUAL：双语报告（自动生成另一语种版本）——
# REPORT_BILINGUAL=true                # 报告末尾（finalize/可视化/纯度之后）自动生成成稿的另一语种版本：英文报告→简体中文版、中文报告→analyst-grade 英文版；按 H2 章节边界并发逐章翻译（严格保留 markdown 结构/表格列数/代码&mermaid 围栏原样/图片URL/引用标记/数字概率逐字节），落 reports/{id}/full_report.{en|zh}.md 并把 translations 条目（含数字完整性 quality）写入 meta；GET /api/report/{id}/full_report.{en|zh}.md 取译文、/pdf?lang=en|zh 取译文 PDF；非中英文脚本/任何失败 degrade-safe 跳过（主报告不受影响）；默认开（BILINGUAL）
# REPORT_TRANSLATION_CONCURRENCY=4     # BILINGUAL 逐章翻译并发度（ThreadPoolExecutor 线程数），下限 1（串行）；默认 4（BILINGUAL）
# REPORT_TRANSLATION_CONTAMINATION_RETRIES=3  # rounds that re-translate source-language lines a translated variant kept (clamped to 1-5; 0 = 3); anything still contaminated is rejected by the publication audit (INFRA-14)
# REPORT_TRANSLATION_RESIDUAL_LINES=3  # Translation may publish with up to this many source-language lines (min(N, 1 per 200 lines, ≥1)), recorded as a warning; 0 = strict fail-closed
# REPORT_TRANSLATION_RESIDUAL_LINE_RETRIES=12 # Still-untranslated lines that get a last whole-line retranslation (2 prompts each)
# REPORT_TRANSLATION_CALL_TIMEOUT_S=240 # Per-request timeout for translation model calls (client default 600 s); a timeout is retried
# —— PM-2：确定性逐预测市场锚定 ——
# FORECAST_MARKET_ANCHORING=true       # PM-2 二元预测抽取后跑一次批处理 LLM 匹配（陈述×相关性门控市场表）并确定性回填 rich market_anchor（隐含概率取快照/divergence 本地算）；false 回到「仅模型自愿转录锚点」的 opt-in 行为（取证 0/13 命中）
# FORECAST_MARKET_ANCHOR_MIN_EQUIVALENCE=near  # PM-2 锚定采纳的最小 resolution_equivalence 严格度 exact|near|loose（默认 near=采纳 exact/near、丢弃 loose 宽泛主题匹配）
# MARKET_ANCHOR_PRICE_TIME=true        # EVAL-6 市场价时溯源：重报价成功的行记 quoted_at、handoff 快照/报告期现抓行记 snapshot_as_of（快照 as_of/现抓时刻，只是取价时刻的上界），锚点据此写 price_time + price_time_basis（requote|snapshot，未知不写；requote 时 price_at_research 实为报告期重报价）；纯溯源不动概率/锚定/发布闸门；false=市场行与锚点逐字节复现旧形状
# FORECAST_MARKET_DIVERGENCE_MIN_CONFIDENCE=0.6  # i7 P0 影响边界：10pp 分歧重述（可移动概率）只对 match_confidence ≥ 此值的锚点开放；低信心匹配仅作展示锚点、绝不影响已发布概率。被采纳的移动会盖不可移除的 market_influence 印章，对账弹锚时回滚
# FORECAST_MARKET_DIVERGENCE_REVISION=true     # PM-2 10pp 规则：锚定后 |model_p−market_p|>0.10 且理由未提市场的预测做一次有界重述，须引用市场或有依据地保留分歧（绝不静默移动概率）；false=不重述
# FORECAST_MARKET_BLEND_ARITHMETIC=false       # REPORT-12 the 10pp restatement asks only for a market_weight w + market-citing rationale (all or none); code computes (1-w)*p + w*m from the snapshot price, stamps market_influence.blend and shows the formula in the Market Cross-Check; default off (moves published probabilities: promote via WP14), off = legacy free-probability restatement, byte-identical
# FORECAST_MARKET_BLEND_WEIGHT_MAX=0.8         # REPORT-12 largest market_weight accepted (clamped to [0, 1] and floored to two decimals; weights are rounded to two decimals; a larger weight rejects the whole revision); markets are anchors, not truth
# FORECAST_DRAW_DOSSIER_STRIP_MARKET_TABLE=false  # REPORT-10 注入实时市场包时，二元抽取的 dossier 视图删掉研究桥追加的「## Prediction Market Signals」机器市场表（研究期价格的重复、可能过时副本；围栏感知），删除节数记 binary_quality.market_table_stripped；默认关（可能改变二元概率，先对比再晋升），关=提示词逐字节不变
# REPORT_MARKET_XCHECK_DISCLOSURE=true  # REPORT-10 Market Cross-Check 说明句追加披露：预测起草时已参考市场价格，Δ 是锚定之后的差值而非独立于市场的估计；false=说明句逐字节恢复旧文案
# —— RQ-2：成稿后抽取切片（head+tail）+ 抽取 max_tokens ——
# FORECAST_EXTRACT_BUDGET=40000        # RQ-2 情景抽取的 dossier 字符预算（前 head_ratio + 后 1-head_ratio 两段拼接，取代 head-only 截断）
# FORECAST_BINARY_EXTRACT_BUDGET=48000 # RQ-2 二元抽取的 dossier 字符预算（同样 head+tail 切片）
# FORECAST_EXTRACT_HEAD_RATIO=0.6      # RQ-2 head+tail 切片的头部占比（0.05-0.95；小=偏结论/大=偏导言）
# FORECAST_EXTRACT_MAX_TOKENS=4096     # RQ-2 情景抽取 max_tokens（2048→4096，防 5 情景 × anchor/rationale/criteria 被截断成断裂 JSON）
# —— RESEARCH-13：概率提示词的确定性证据包（零 LLM 调用；回放：backend/scripts/context_pack_replay.py）——
# FORECAST_CONTEXT_PACK_BINARY=false   # RESEARCH-13 二元抽取改用按 H2 节分类的 dossier 摘录（可判定/二元节优先，References/Visual Annex/How to Read 永不入包）+ as_of 过滤的近期进展时间线通道，取代 head+tail 切片与 [Situation brief]；包落 reports/<id>/context_pack_binary.json，摘要记 forecast.context_pack；默认关（可能移动概率，按回放指标+人工抽查晋升），关=提示词逐字节不变
# FORECAST_CONTEXT_PACK_SPINE=false    # RESEARCH-13 骨架以「研究证据包（按时点标注）」（执行摘要/情景节、局势简报、as_of 切分时间线、关键指标）取代 [态势简报] 2000 字切片，EVAL-11 影子检查同样带包；默认关，关=提示词逐字节不变
# FORECAST_CONTEXT_PACK_BINARY_BUDGET=48000  # RESEARCH-13 二元包 dossier 摘录字符预算（时间线通道不计入：封顶约 7.6k 字；同时去掉 2k 的 [Situation brief]，净增约 5.6k）
# FORECAST_CONTEXT_PACK_SPINE_BUDGET=14000   # RESEARCH-13 骨架证据包总字符预算
# FORECAST_SCHEDULED_LIVE_WINDOW_DAYS=30     # RESEARCH-13 日期晚于 as_of 的「已排期」条目仅在 as_of 距今 ≤ 此天数时展示，否则扣下并计数（回溯运行防事后信息）；回测运行（TIME-6 回测钉）一律扣下
# REPORT_CHRONOLOGY_ASOF_SPLIT=false   # RESEARCH-13 章节「关键事件时间线」块按 as_of 切分为已发生（最近 15 条）+ 单列「已排期」子列表（同一实时运行门）；默认关，关=块逐字节不变
# REPORT_CONSENSUS_DIAGNOSTICS=off     # RESEARCH-6 off|shadow: shadow groups the research quantitative projections by metric family (else forecaster-free metric), region, target year and unit; groups with >= 2 forecasters record min/max/median, max/min spread ratio, vintages, staleness and same-forecaster revisions, rows dated after the as-of (actors.as_of_date, else the hindcast pin's) are excluded (after_as_of, or as_of_is_target for a target date misplaced there; without a full as-of day no guard runs and the digest says leakage_guard false). Written to reports/<id>/consensus_evidence.json (drf.consensus_diagnostics/v1) with a digest in forecast.quality.consensus; zero model calls, no prompt/probability/gate change. off (default, or any other value) = no key, no file

# ===== ITEM 4：MCP 服务器旋钮（app/mcp/{kg_server,sim_server}.py；仅这两台 MCP stdio 子进程读取，主后端 Config 不读；全部有安全默认，留空即要求逐调用传 id）=====
# 说明：这些不是 backend Config 读取的旋钮，而是 MCP 服务器进程经环境变量读取的默认值，经 deerflow_bridge/extensions_config.json
#      的 env 段注入。degrade-safe：留空则工具要求逐调用显式传 graph_id/sim_id，缺失/超时一律返回结构化错误 {ok:false,error} 且绝不 hang。
# DRF_MCP_KG_GRAPH_ID=                 # kg_server 进程默认图谱 ID（工具未显式传 graph_id 时使用；亦可用 `--graph-id` 命令行参数）。留空=每次调用必须传 graph_id。
# DRF_MCP_KG_TIMEOUT=60                # kg_server 单次工具调用超时上限（秒）；图谱后端慢/卡时到点放弃并返回 TimeoutError 结构化错误，绝不 hang 协议。非正值回退 60。
# DRF_MCP_SIM_ID=                      # sim_server 进程默认模拟 ID（工具未显式传 sim_id 时使用；亦可用 `--sim-id` 命令行参数）。留空=每次调用必须传 sim_id。
# DRF_MCP_SIM_TIMEOUT=120             # sim_server 采访默认超时上限（秒）；采访工具外层看门狗=此值+30s。非正值回退 120。

# ===== Wave 9 旋钮（研究提速/研究质量/编排恢复/KG 修剪/报告打磨；全部有安全默认，留空即保持修复后的默认行为）=====
# —— 研究提速（deerflow_bridge 直读 os.environ，经编排器 env 原样下发给子进程）——
# RESEARCH_GAP_SET_REPLACE=true        # W9 自适应收口 gap 集语义：每轮用本轮仍未决的 gaps **替换**累积集（归一化后无变化=平台期即停）；false 恢复旧的只并集累积（不收敛长尾根因）
# CLAUDE_RETRY_AFTER_CAP_S=120         # W9 claude_provider 对 Retry-After 头的睡眠上限（秒）：超过上限（周配额/plan 限额，实测出现过 467421s=5.4 天）直接抛 RetryAfterCapExceededError 快失败；0=恢复旧的无上限睡眠
# RESEARCH_FANOUT_OVERLAP_SCOPE=true   # W9 深度 fan-out worker 与主线程 deep-phase-1 scope 回合并发飞（scope 后 join+吸收再进并行中段）；false 恢复阻塞式顺序 fan-out
# RESEARCH_INCREMENTAL_TOPUP=true      # W9 三角验证 top-up / judge-refine 用一次有界裸模型调用对既有报告做分节补丁（<<<SECTION>>>/<<<APPEND>>> 确定性拼接、绝不变短），取代全量重合成；false 恢复全量 synthesize
# RESEARCH_TOPUP_PATCH_MAX_SECTIONS=4  # W9 增量补丁受影响分节数上限：超过即回退全量重合成（解析失败/净负增量同样回退）
# RESEARCH_DEGENERATE_TOOL_CORRECT_AT=8  # W9 连续被拒/畸形工具调用达 N 次时结束流段并注入一行确定性纠偏消息（一次为限）；0=关闭纠偏注入
# RESEARCH_DEGENERATE_TOOL_BREAK_AT=16 # W9 连续退化工具调用达 N 次时抛 _DegenerateToolLoopError 进入既有 GraphRecursionError 打捞路径；0=关闭熔断
# RESEARCH_BRIEF_DRIFT_AS_MESSAGE=true # W9 brief 漂移纠偏经 update_state 以纯线程消息注入（不烧一个带工具的 agent 回合）；任何失败自动回退旧的 agent 回合注入；false 直接走旧路径
# RESEARCH_SEARCH_CACHE_TTL_H=6        # W9 web_search 结果磁盘缓存存活期（小时）：键=sha256(实际 provider+归一化 query+max_results)，镜像 cached_fetch 语义；0=关闭。pytest 内除非显式设置否则自动 0（测试隔离）
# RESEARCH_SEARCH_CACHE_DIR=           # W9 搜索缓存目录；留空=<部署模块目录>/.cache/search_cache
# RESEARCH_SEARCH_CACHE_MAX_MB=200     # W9 搜索缓存目录字节上限（MB）：超限按 mtime LRU 淘汰；错误/空/过短结果一律不落盘
# —— 研究质量（bridge 直读 env；config.py 同名镜像仅作文档/一致性）——
# RESEARCH_BAN_PROCESS_NARRATION=true  # W9 成稿风格硬规则：禁止过程叙述（passes/工作笔记/coverage gate/字数汇报/自指编辑注记）进入所有写作/合成提示词；工作笔记标记为 INTERNAL 脚手架
# RESEARCH_INLINE_CITATIONS=true       # W9 行内引用：合成路径钉入编号 SOURCE INDEX（与 sources.json fetched 主干同序）+ [S<n>] 标记；确定性 finalizer 校验/剥离悬空标记并追加机器可读 References 节
# RESEARCH_CITATION_INDEX_MAX=100      # W9 钉入合成提示词的引用索引条目上限
# RESEARCH_DEDUP_SHINGLES=true         # W9 多段合成缝合后跑归一化 12-gram shingle 检测，移除跨节逐字重复段（保留首次出现；同节重复不动）
# RESEARCH_CHARTS_MIN=3                # 研究报告需要支持的最少图表类别/确定性渲染下限；工具自由的合成回合只交付带单位、日期、定义和来源的 chart-ready 数据，抽取后由 forecast-visuals/render.py 统一生成 Plotly HTML + PNG；0=关闭确定性渲染步
# RESEARCH_CHARTS_TIMEOUT=180          # W9 render.py 子进程墙钟上限（秒）
# RESEARCH_CHARTS_PYTHON=              # W9 跑 render.py 的解释器覆盖；留空=自动探测 backend/.venv/bin/python → sys.executable
# PREDICTION_MARKETS_HORIZON_RETRY=true # W9 市场快照为空/全被门挡时跑地平线降级阶梯（剥 4 位年份→事件级 3 词查询）重试；降级候选强制过 LLM 相关性门（fail-closed），命中行带 horizon_degraded 标；prediction_markets.json 现在**总是**落盘（空时带 no_relevant_markets 标记）
# PREDICTION_MARKETS_HTTP_TIMEOUT_SECONDS=3 # Gamma/CLOB 单请求超时；默认只试 1 次。
# PREDICTION_MARKETS_DEADLINE_SECONDS=15 # 整个市场快照阶段墙钟预算，候选并发拉取并在 deadline 到点停止。
# PREDICTION_MARKETS_WORKERS=4         # 市场候选网络请求并发上限。
# PREDICTION_MARKETS_TRANSPORT_FAILURE_BREAK_AT=3 # 连续 transport failures 后本次 synthesis 跳过剩余网络刷新，使用已聚合候选或诚实空快照。
# —— 编排器恢复 / 种子集成 / 遥测（backend Config 读取）——
# PIPELINE_SALVAGE_COMPLETED_ORPHANS=true # W9 孤儿回收：report 阶段已完成（full_report.md+forecast.json 在盘）的孤儿管线打捞为 completed(pipeline_health=degraded, ensemble-skipped) 而非 failed；配套 scripts/salvage_orphaned_pipelines.py（默认 dry-run，--apply 生效）
# PIPELINE_TELEMETRY_FLUSH_EVERY_CALLS=20 # W9 run_telemetry.json 增量落盘节流：每 N 次 LLM 调用（心跳/进度回调检查）+ 每次阶段转换/失败即 flush；重启绝不清零累计
# ENSEMBLE_SEMANTIC_ALIGN=true         # W9 种子集成情景桶语义对齐：精确名匹配 → resolution-criteria token-Jaccard 回退（同 run 防自并桶）；支持数 <2 的桶 agreement=None；false 逐字节回退旧对齐
# ENSEMBLE_ALIGN_MIN_OVERLAP=0.34      # W9 语义对齐的最小 token-Jaccard 重叠度
# RESEARCH_TRACK_RECONCILE=true        # W9 多轨研究合并后跑一次有界（~30K 字符、仅执行摘要）LLM 调和：合并各轨执行摘要+产出跨轨分歧节+把 '# Track N' H1 降为 '## Part N — <标题>' H2；失败降级为纯拼接
# RESEARCH_MCP_KG=true                 # W9 研究子进程 MCP 接图谱：state.graph_id 已存在时设 DEER_FLOW_EXTENSIONS_CONFIG_PATH（部署目录 extensions_config.json）+ DRF_MCP_KG_GRAPH_ID；图谱缺失时 kg_server 返回结构化错误绝不 hang
# REPORT_LINT=true                     # W9 研究成稿跑 report_lint.lint_report(md, lang, mode='research')（CJK 占比推断语言），清洗后写回 handoff；ImportError 安全跳过
# —— KG 修剪 / GC / UI 子图 / 抽取加固（backend Config 读取）——
# GRAPH_PRUNE_ENABLED=true             # W9 resolve_entities 后硬剪枝为核心 actor（名+别名）+ N-hop 内重要节点；keep-set 外全部删除（零核心命中即整体跳过）；删除后重读核验并审计到 handoff/graph_prune.json
# GRAPH_MAX_ENTITIES=400               # W9 实体硬上限；核心节点超过时有效上限自动提升以保证核心全保留
# GRAPH_CORE_ACTOR_HOPS=2              # W9 核心 actor 邻域保留跳数；0=仅保留核心
# GRAPH_PRUNE_MIN_CORE_COVERAGE=0.8    # W9 destructive prune 最低 actor 行命中率；不足则不删并标 degraded
# GRAPH_PRUNE_MIN_DEGREE=2             # 已弃用兼容项；硬剪枝不再按度数/任意长连通路径豁免节点
# GRAPH_MAX_ENTITIES_PER_TYPE=150      # W9 保留集逐实体类型上限
# GRAPH_RETAIN_COUNT=5                 # W9 gc_stale_graphs 保留最新 N 个未被 pipeline/project 引用的图谱（启动+删除管线时跑；在飞管线缺 graph_id 记录时整体跳过）
# GRAPH_UI_MAX_NODES=400               # W9 /api/graph/data top_k=0 时的 UI overview 上限；与前端默认/物理 hard cap 对齐
# GRAPH_UI_CACHE_TTL_S=60              # W9 /graph/data 原始抓取 TTL 缓存（秒）；建图完成/修剪/删除即失效；0=关闭
# GRAPH_LAYOUT_PRECOMPUTE=true         # W9 建图完成/修剪后预计算 networkx spring 布局（radial 回退），持久化 GRAPHITI_DATA_DIR/layouts/<graph_id>/positions.json，/graph/data 附带 positions
# GRAPH_EPISODE_SCHEMA_RETRIES=1       # W9 episode 级 schema-echo 抽取失败的重滚次数（adapter 纠偏+温度阶梯之外）
# GRAPH_INGEST_RATE_LIMIT_COOLDOWN_S=15 # 并发图谱写入遇 429 后，失败片段串行重放前的单次冷却（0–60 秒）
# GRAPH_INGEST_FALLBACK=true           # W9 episode 抽取重滚穷尽后经 LLM_FALLBACK_PROVIDER/_MODEL/_API_KEY/_BASE_URL 换客户端再试（引用计数 swap）；跳块原因计数入 last_ingest_stats.skip_reasons
# —— 报告引用 / 语言 / 结构打磨（backend Config 读取；report_agent/report_lint/report_visualizer）——
# REPORT_CITATION_FINALIZER=true       # W9 成稿引用确定性收尾：校验 [S<n>] 标记 vs References/钉入索引，剥离悬空标记并计数
# REPORT_CITATION_REPAIR=true          # W9 引用修复回填（对 sources 索引解析/回填占位引用）
# REPORT_CITATION_SINGLE_GRAMMAR=true  # W9 统一引用语法为 [S<n>]（禁 [citation:...](url) 等混杂形态）
# REPORT_SOURCES_INDEX_MAX=60          # W9 报告侧来源索引条目上限
# REPORT_TRANSLATION_CITATION_PARITY=true # W9 双语翻译保持引用标记逐字节一致性校验
# REPORT_PDF_CITATION_FOOTNOTES=true   # W9 PDF 导出把 [S<n>] 渲染为脚注锚
# REPORT_EVIDENCE_BLOCKS=true          # W9 章节证据块（引用+数字接地的 evidence 摘录）
# REPORT_KEY_METRICS_MAX=40            # W9 关键指标表行数上限
# REPORT_VERIFIED_FACTS_BLOCK=true     # REPORT-8 研究数字带页面核验标签时，以「已核验指标」块（在页核验通过的已报告值 + 标注非已发生结果的预期；[S#] 只取引用索引内记号）替代关键指标表，并注入 Part 2 综合；无标签/关闭 = 旧表与提示词逐字节不变
# REPORT_VERIFIED_FACTS_MAX_ROWS=40    # REPORT-8 已核验指标块行数上限（超限先丢预期、再丢陈旧、再丢最旧）
# REPORT_VERIFIED_FACTS_MAX_CHARS=6000 # REPORT-8 已核验指标块字符上限（表头与规则段不截断；也是 Part 2 注入的上限）
# REPORT_CONTESTED_TABLE_MAX=15        # W9 争议声明表行数上限
# REPORT_CHRONOLOGY_MAX_EVENTS=25      # W9 紧凑时间线事件上限
# REPORT_KG_STRUCTURAL_SPINE=true      # W9 图谱结构先验（中心度/咽喉）作为报告结构骨架输入
# REPORT_SCENARIO_SPINE_PIN=true       # W9 主情景骨架钉入种子 ReportAgent（scenario_spine kwargs；TypeError 回退旧签名）
# REPORT_EDITORIAL_LINT=true           # W9 成稿编辑 lint（标题/结构/流程叙述清洗）
# REPORT_PROJECTION_LINT=true          # RESEARCH-5 已报告 vs 预期归因观测（只记数/采样，不改成稿、不进发布门）：预期行被写成已发生（projection_as_fact）等计数写入 final_audit.json 与 forecast.quality.final_audit 的 projection_attribution（总写）及 forecast.quality.projection_attribution（仅 REPORT_EDITORIAL_LINT 开时）；false = 各处都不写
# REPORT_OUTLINE_TITLE_LINT=true       # W9 大纲标题 lint（去 Track/Part 编号残留等）
# REPORT_SIMLEAK_REPAIR=true           # W9 模拟内部机制泄漏（agent 轮次/平台名等）检测+定向修复
# REPORT_SIMLEAK_MAX_LLM_PARAGRAPHS=12 # W9 simleak 修复单次 LLM 重写段落上限
# REPORT_SIGNAL_PACK_QUALITATIVE=true  # W9 信号包附带定性信号（除数字底座外）
# REPORT_SECTION_LANG_ENFORCE=true     # W9 逐章语言纯度强制（非目标语脚本占比超阈值即重写）
# REPORT_SECTION_LANG_MAX_FOREIGN_RATIO=0.25 # W9 逐章异语脚本占比阈值
# REPORT_PURITY_RETRANSLATE_SEGMENTS=8 # W9 语言纯度批量内联重译的片段数上限
# REPORT_REVISION_MIN_RATIO=0.6        # W9 章节修订稿最短长度比（防修订把章节改没）
# REPORT_SECTION_MIN_VALID_RATIO=0.4   # W9 有效章节比例下限（低于即报告健康降级）
# REPORT_SECTION_TRUNCATION_CONTINUE=true # W9 章节截断侦测后自动续写补全
# REPORT_VIZ_PNG_EXPORT=true           # W9 plotly→kaleido 静态 PNG 导出（缺失/失败自动回退 matplotlib/仅 HTML）
# REPORT_VIZ_INTERACTIVE_EMBED=true    # W9 成稿内嵌交互式图表引用（png_path 静态对+交互版链接）
# REPORT_VIZ_MERMAID_ANNEX_ONLY=true   # W9 Mermaid 图只入附录不就地插入（前端无 mermaid 渲染器，就地插入呈现为代码块）
# REPORT_VIZ_TIMELINE_MAX_EVENTS=40    # W9 时间线泳道图事件上限
# REPORT_VIZ_NETWORK_MAX_NODES=60      # W9 actor 关系网络图节点上限

# ===== 内部 / 测试（勿在部署环境设置）=====
# DRF_TEST_PROCESS=                   # 仅 backend/tests/conftest.py 在导入 app 前设为 1：测试进程不加载根 .env，各旋钮取代码默认值（防止开发机 .env 泄漏进 pytest）。生产/开发运行请勿设置
